+		.interlaced = V4L2_DV_PROGRESSIVE,
+		.width = 1920,
+		.height = 1080,
+		.hfrontporch = 88,
+		.hsync = 44,
+		.hbackporch = 148,
+		.vfrontporch = 4,
+		.vsync = 5,
+		.vbackporch = 36,
+		.pixelclock = 148500000,
+	},
+};
