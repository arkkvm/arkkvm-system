From ce657728ec4bc85d545273dd8c2d19ac6baad9f8 Mon Sep 17 00:00:00 2001
From: Chen Shunqing <csq@rock-chips.com>
Date: Mon, 4 Dec 2023 07:36:29 +0000
Subject: [PATCH 204/232] media: i2c: rk628: add version parse func

Signed-off-by: Chen Shunqing <csq@rock-chips.com>
Change-Id: I84b6d491ccdc3e12ffbff30bebb8fe28de231a87
Signed-off-by: Guochun Huang <hero.huang@rock-chips.com>
---
 drivers/media/i2c/rk628/rk628.c | 23 +++++++++++++++++++++++
 drivers/media/i2c/rk628/rk628.h | 10 +++++++++-
 2 files changed, 32 insertions(+), 1 deletion(-)

diff --git a/drivers/media/i2c/rk628/rk628.c b/drivers/media/i2c/rk628/rk628.c
index df82e1d9480137..d43c8dbf1497ea 100644
--- a/drivers/media/i2c/rk628/rk628.c
+++ b/drivers/media/i2c/rk628/rk628.c
@@ -642,6 +642,29 @@ void rk628_post_process_en(struct rk628 *rk628,
 	rk628_post_process_scaler_init(rk628, src, dst);
 }
 
+static const char * const rk628_version[] = {
+	"UNKNOWN",
+	"RK628D",
+	"RK628F",
+};
+
+void rk628_version_parse(struct rk628 *rk628)
+{
+	u32 version;
+
+	rk628_i2c_read(rk628, GRF_SOC_VERSION, &version);
+	if (version == 0x20200326)
+		rk628->version = RK628D_VERSION;
+	else if (version == 0x20230321)
+		rk628->version = RK628F_VERSION;
+	else
+		rk628->version = RK628_UNKNOWN;
+
+	dev_info(rk628->dev, "rk628 version is: %s (%x)\n",
+		 rk628_version[rk628->version], version);
+}
+EXPORT_SYMBOL(rk628_version_parse);
+
 MODULE_AUTHOR("Shunqing Chen <csq@rock-chips.com>");
 MODULE_DESCRIPTION("Rockchip RK628 driver");
 MODULE_LICENSE("GPL v2");
diff --git a/drivers/media/i2c/rk628/rk628.h b/drivers/media/i2c/rk628/rk628.h
index 1ae888ad6f7089..6146305a03d38b 100644
--- a/drivers/media/i2c/rk628/rk628.h
+++ b/drivers/media/i2c/rk628/rk628.h
@@ -194,7 +194,7 @@
 #define GRF_OS_REG1			0x0144
 #define GRF_OS_REG2			0x0148
 #define GRF_OS_REG3			0x014c
-#define GRF_SOC_VERSION			0x0150
+#define GRF_SOC_VERSION			0x0200
 #define GRF_MAX_REGISTER		GRF_SOC_VERSION
 
 #if (LINUX_VERSION_CODE >= KERNEL_VERSION(4, 19, 0))
@@ -247,10 +247,17 @@ enum {
 	RK628_DEV_MAX,
 };
 
+enum {
+	RK628_UNKNOWN,
+	RK628D_VERSION,
+	RK628F_VERSION,
+};
+
 struct rk628 {
 	struct device *dev;
 	struct i2c_client *client;
 	struct regmap *regmap[RK628_DEV_MAX];
+	u8 version;
 	void *txphy;
 };
 
@@ -298,6 +305,7 @@ void rk628_post_process_en(struct rk628 *rk628,
 			   struct videomode *src,
 			   struct videomode *dst,
 			   u64 *dst_pclk);
+void rk628_version_parse(struct rk628 *rk628);
 
 #include "rk628_grf.h"
 #include "rk628_gpio.h"
-- 
2.17.1

