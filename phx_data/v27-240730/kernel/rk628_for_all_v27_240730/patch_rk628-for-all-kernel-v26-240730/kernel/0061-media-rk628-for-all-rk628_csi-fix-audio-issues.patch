+static void rk628_csi_delayed_work_audio_rate_change(struct work_struct *work)
+{
+	u32 fifo_ints, fifo_fillsts;
+	u32 fs_audio;
+	struct delayed_work *dwork = to_delayed_work(work);
+	struct rk628_csi *csi = container_of(dwork, struct rk628_csi,
+					     delayed_work_audio_rate_change);
+
+	mutex_lock(&csi->confctl_mutex);
+	fs_audio = rk628_hdmirx_audio_fs(csi);
+	dev_dbg(csi->dev, "%s get audio fs %u\n", __func__, fs_audio);
+	if (csi->audio_state.ctsn_flag == (ACR_N_CHG_ICLR | ACR_CTS_CHG_ICLR)) {
+		csi->audio_state.ctsn_flag = 0;
+		if (is_validfs(fs_audio)) {
+			rk628_hdmirx_audio_set_fs(csi, fs_audio);
+			rk628_i2c_read(csi->rk628, HDMI_RX_AUD_FIFO_ISTS, &fifo_ints);
+			dev_dbg(csi->dev, "%s fifo ints %#x\n", __func__, fifo_ints);
+			if ((fifo_ints & 0x18) == 0x18)
+				rk628_hdmirx_audio_fifo_initd(csi);
+			else if (fifo_ints & 0x18)
+				rk628_hdmirx_audio_fifo_init(csi);
+			rk628_i2c_update_bits(csi->rk628, HDMI_RX_DMI_DISABLE_IF,
+					   AUD_ENABLE_MASK, AUD_ENABLE(1));
+			/* We start audio work after recieveing cts n interrupt */
+			csi->fifo_ints_en = true;
+			rk628_i2c_write(csi->rk628, HDMI_RX_AUD_FIFO_IEN_SET,
+				     AFIF_OVERFL_ISTS | AFIF_UNDERFL_ISTS);
+			schedule_delayed_work(&csi->delayed_work_audio, msecs_to_jiffies(1000));
+		} else {
+			dev_dbg(csi->dev, "%s invalid fs when ctsn updating\n", __func__);
+		}
+	}
+	if (csi->audio_state.fifo_int) {
+		csi->audio_state.fifo_int = false;
+		if (is_validfs(fs_audio))
+			rk628_hdmirx_audio_set_fs(csi, fs_audio);
+		rk628_i2c_read(csi->rk628, HDMI_RX_AUD_FIFO_FILLSTS1, &fifo_fillsts);
+		if (!fifo_fillsts) {
+			dev_dbg(csi->dev, "%s underflow after overflow\n", __func__);
+			rk628_hdmirx_audio_fifo_initd(csi);
+		} else {
+			dev_dbg(csi->dev, "%s overflow after underflow\n", __func__);
+			rk628_hdmirx_audio_fifo_initd(csi);
+		}
+	}
+	mutex_unlock(&csi->confctl_mutex);
+}
