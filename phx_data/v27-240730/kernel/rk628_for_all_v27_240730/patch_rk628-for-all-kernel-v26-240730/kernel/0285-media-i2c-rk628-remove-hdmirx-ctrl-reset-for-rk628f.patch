 				schedule_delayed_work(&csi->delayed_work_enable_hotplug,
 						      msecs_to_jiffies(1100));
 			} else {
@@ -1539,18 +1538,20 @@ static void rk628_csi_error_process(struct v4l2_subdev *sd)
 	}
