+struct mipi_timing {
+	u8 data_prepare;
+	u8 data_zero;
+	u8 data_trail;
+	u8 clk_prepare;
+	u8 clk_zero;
+	u8 clk_trail;
+	u8 clk_post;
+};
+
 struct rk628 {
 	struct device *dev;
 	struct i2c_client *client;
@@ -273,6 +286,9 @@ struct rk628 {
 	u8 version;
 	void *txphy;
 	struct mutex rst_lock;
+	u8 dphy_lane_en;
+	bool dual_mipi;
+	struct mipi_timing mipi_timing[2];
 };
 
 #ifndef RK628_REGMAP
