@@ -439,11 +439,11 @@ static void rk628_bt1120_delayed_work_enable_hotplug(struct work_struct *work)
 		rk628_hdmirx_controller_setup(bt1120->rk628);
 		rk628_hdmirx_hpd_ctrl(sd, true);
 		ret = rk628_hdmirx_config_all(sd);
+		if (bt1120->cec && bt1120->cec->adap)
+			rk628_hdmirx_cec_state_reconfiguration(bt1120->rk628, bt1120->cec);
 		rk628_bt1120_enable_interrupts(sd, true);
 		rk628_i2c_update_bits(bt1120->rk628, GRF_SYSTEM_CON0,
 				SW_I2S_DATA_OEN_MASK, SW_I2S_DATA_OEN(0));
-		if (bt1120->plugin_status != plugin && bt1120->cec && bt1120->cec->adap)
-			cec_queue_pin_hpd_event(bt1120->cec->adap, true, ktime_get());
 		bt1120->plugin_status = plugin;
 		if (ret)
 			schedule_delayed_work(&bt1120->delayed_work_enable_hotplug, 1000);
@@ -451,8 +451,6 @@ static void rk628_bt1120_delayed_work_enable_hotplug(struct work_struct *work)
 		bt1120->nosignal = true;
 		rk628_hdmirx_plugout(sd);
 		rk628_set_io_func_to_gpio(bt1120->rk628);
-		if (bt1120->plugin_status != plugin && bt1120->cec && bt1120->cec->adap)
-			cec_queue_pin_hpd_event(bt1120->cec->adap, false, ktime_get());
 		bt1120->plugin_status = plugin;
 	}
 	mutex_unlock(&bt1120->confctl_mutex);
@@ -543,6 +541,9 @@ static void rk628_hdmirx_hpd_ctrl(struct v4l2_subdev *sd, bool en)
 	set_level = en ? en_level : !en_level;
