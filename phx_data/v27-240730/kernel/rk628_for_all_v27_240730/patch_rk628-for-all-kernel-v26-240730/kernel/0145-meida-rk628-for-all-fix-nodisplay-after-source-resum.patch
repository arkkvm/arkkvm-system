From fceee408b5dbbb6c519d288090e7fc2ef20c86bf Mon Sep 17 00:00:00 2001
From: Chen Shunqing <csq@rock-chips.com>
Date: Fri, 20 May 2022 01:03:15 +0000
Subject: [PATCH 145/232] meida: rk628-for-all: fix nodisplay after source
 resume

Signed-off-by: Chen Shunqing <csq@rock-chips.com>
Change-Id: I1c6f0868d00885d4c65099ba4040244033792b16
Signed-off-by: Guochun Huang <hero.huang@rock-chips.com>
---
 drivers/media/i2c/rk628/rk628_bt1120_v4l2.c | 9 +++++++--
 drivers/media/i2c/rk628/rk628_csi.c         | 9 +++++++--
 drivers/media/i2c/rk628/rk628_csi_v4l2.c    | 9 +++++++--
 3 files changed, 21 insertions(+), 6 deletions(-)

diff --git a/drivers/media/i2c/rk628/rk628_bt1120_v4l2.c b/drivers/media/i2c/rk628/rk628_bt1120_v4l2.c
index 7a31aa63297f0c..873221dcd4f03d 100644
--- a/drivers/media/i2c/rk628/rk628_bt1120_v4l2.c
+++ b/drivers/media/i2c/rk628/rk628_bt1120_v4l2.c
@@ -438,7 +438,7 @@ TIMING_ERR:
 	return -ENOLCK;
 }
 
-static void rk628_hdmirx_config_all(struct v4l2_subdev *sd)
+static int rk628_hdmirx_config_all(struct v4l2_subdev *sd)
 {
 	int ret;
 	struct rk628_bt1120 *bt1120 = to_bt1120(sd);
@@ -449,6 +449,8 @@ static void rk628_hdmirx_config_all(struct v4l2_subdev *sd)
 		rk628_bt1120_format_change(sd);
 		bt1120->nosignal = false;
 	}
+
+	return ret;
 }
 
 static void rk628_hdmirx_reset_regfile(struct v4l2_subdev *sd)
@@ -489,6 +491,7 @@ static void rk628_bt1120_delayed_work_enable_hotplug(struct work_struct *work)
 			delayed_work_enable_hotplug);
 	struct v4l2_subdev *sd = &bt1120->sd;
 	bool plugin;
+	int ret;
 
 	mutex_lock(&bt1120->confctl_mutex);
 	bt1120->avi_rcv_rdy = false;
@@ -500,10 +503,12 @@ static void rk628_bt1120_delayed_work_enable_hotplug(struct work_struct *work)
 		rk628_hdmirx_audio_setup(bt1120->audio_info);
 		rk628_hdmirx_set_hdcp(bt1120->rk628, &bt1120->hdcp, bt1120->enable_hdcp);
 		rk628_hdmirx_hpd_ctrl(sd, true);
-		rk628_hdmirx_config_all(sd);
+		ret = rk628_hdmirx_config_all(sd);
 		rk628_bt1120_enable_interrupts(sd, true);
 		rk628_i2c_update_bits(bt1120->rk628, GRF_SYSTEM_CON0,
 				SW_I2S_DATA_OEN_MASK, SW_I2S_DATA_OEN(0));
+		if (ret)
+			schedule_delayed_work(&bt1120->delayed_work_enable_hotplug, 1000);
 	} else {
 		rk628_bt1120_enable_interrupts(sd, false);
 		enable_stream(sd, false);
diff --git a/drivers/media/i2c/rk628/rk628_csi.c b/drivers/media/i2c/rk628/rk628_csi.c
index ce68f6b459afd7..2c492446f9e992 100644
--- a/drivers/media/i2c/rk628/rk628_csi.c
+++ b/drivers/media/i2c/rk628/rk628_csi.c
@@ -488,7 +488,7 @@ TIMING_ERR:
 	return -ENOLCK;
 }
 
-static void rk628_hdmirx_config_all(struct rk628_csi *csi)
+static int rk628_hdmirx_config_all(struct rk628_csi *csi)
 {
 	int ret;
 
@@ -498,6 +498,8 @@ static void rk628_hdmirx_config_all(struct rk628_csi *csi)
 		rk628_csi_format_change(csi);
 		csi->nosignal = false;
 	}
+
+	return ret;
 }
 
 static void rk628_csi_delayed_work_enable_hotplug(struct work_struct *work)
@@ -506,6 +508,7 @@ static void rk628_csi_delayed_work_enable_hotplug(struct work_struct *work)
 	struct rk628_csi *csi = container_of(dwork, struct rk628_csi,
 			delayed_work_enable_hotplug);
 	bool plugin;
+	int ret;
 
 	mutex_lock(&csi->confctl_mutex);
 	csi->avi_rcv_rdy = false;
@@ -516,10 +519,12 @@ static void rk628_csi_delayed_work_enable_hotplug(struct work_struct *work)
 		rk628_hdmirx_audio_setup(csi->audio_info);
 		rk628_hdmirx_set_hdcp(csi->rk628, &csi->hdcp, csi->enable_hdcp);
 		rk628_hdmirx_hpd_ctrl(csi, true);
-		rk628_hdmirx_config_all(csi);
+		ret = rk628_hdmirx_config_all(csi);
 		rk628_csi_enable_interrupts(csi, true);
 		rk628_i2c_update_bits(csi->rk628, GRF_SYSTEM_CON0,
 				SW_I2S_DATA_OEN_MASK, SW_I2S_DATA_OEN(0));
+		if (ret)
+			schedule_delayed_work(&csi->delayed_work_enable_hotplug, 1000);
 	} else {
 		rk628_csi_enable_interrupts(csi, false);
 		enable_stream(csi, false);
diff --git a/drivers/media/i2c/rk628/rk628_csi_v4l2.c b/drivers/media/i2c/rk628/rk628_csi_v4l2.c
index c8b4606d99dbfc..dbabf6ce1ba542 100644
