+static long rk628_csi_ioctl(struct v4l2_subdev *sd, unsigned int cmd, void *arg)
+{
+	struct rk628_csi *csi = to_csi(sd);
+	long ret = 0;
+
+	switch (cmd) {
+	case RKMODULE_GET_MODULE_INFO:
+		rk628_csi_get_module_inf(csi, (struct rkmodule_inf *)arg);
+		break;
+	default:
+		ret = -ENOIOCTLCMD;
+		break;
