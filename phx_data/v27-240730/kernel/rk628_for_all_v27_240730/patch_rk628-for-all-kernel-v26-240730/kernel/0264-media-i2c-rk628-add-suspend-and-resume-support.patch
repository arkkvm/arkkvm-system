-		gpiod_set_value(csi->power_gpio, 1);
-		usleep_range(500, 510);
-	}
-
 	if (of_property_read_bool(dev->of_node, "hdcp-enable"))
 		hdcp1x_enable = true;
 
@@ -2681,18 +2755,20 @@ static int rk628_csi_probe(struct i2c_client *client,
 		return err;
 	}
 
