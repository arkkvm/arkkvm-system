+		if (val > 0)
+			cnt++;
+		usleep_range(2000, 2100);
+	}
+
+	ret = (cnt >= 7) ? true : false;
+	dev_dbg(csi->dev, "%s: %d\n", __func__, ret);
+
+	return ret;
+}
