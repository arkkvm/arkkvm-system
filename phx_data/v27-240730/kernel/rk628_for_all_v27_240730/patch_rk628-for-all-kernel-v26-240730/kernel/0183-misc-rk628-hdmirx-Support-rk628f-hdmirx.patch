+static void rk628f_hdmirx_phy_power_on(struct rk628 *rk628)
+{
+	struct rk628_hdmirx *hdmirx = rk628->hdmirx;
+
+	/* power down phy */
+	rk628_i2c_write(rk628, GRF_SW_HDMIRXPHY_CRTL, 0x17);
