From dc07b9280f204c9d530d8e5ecceb7fc4739faf11 Mon Sep 17 00:00:00 2001
From: Guochun Huang <hero.huang@rock-chips.com>
Date: Tue, 10 Aug 2021 17:42:15 +0800
Subject: [PATCH 054/232] misc: rk628: gvi: correcting potential compilation
 errors

Signed-off-by: Guochun Huang <hero.huang@rock-chips.com>
Change-Id: I9a1e6c77bf02b8a87d056de8b8660f473be99fe5
---
 drivers/misc/rk628/rk628_gvi.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/misc/rk628/rk628_gvi.c b/drivers/misc/rk628/rk628_gvi.c
index 170fec96797017..e507efdc11e0d1 100644
--- a/drivers/misc/rk628/rk628_gvi.c
+++ b/drivers/misc/rk628/rk628_gvi.c
@@ -47,7 +47,7 @@ static unsigned int rk628_gvi_get_lane_rate(struct rk628_gvi *gvi)
 {
 	const struct drm_display_mode *mode = rk628_display_get_dst_mode();
 	u32 lane_bit_rate, min_lane_rate = 500000, max_lane_rate = 4000000;
-	unsigned long total_bw;
+	u64 total_bw;
 
 	/**
 	 * [ENCODER TOTAL BIT-RATE](bps) = [byte mode](byte) x 10 / [pixel clock](HZ)
@@ -56,7 +56,7 @@ static unsigned int rk628_gvi_get_lane_rate(struct rk628_gvi *gvi)
 	 *
 	 * 500Mbps <= lane_bit_rate <= 4Gbps
 	 */
-	total_bw = (unsigned long long)gvi->byte_mode * 10 * mode->clock;/* Kbps */
+	total_bw = (u64)gvi->byte_mode * 10 * mode->clock;/* Kbps */
 	do_div(total_bw, gvi->lanes);
 	lane_bit_rate = total_bw;
 
-- 
