From 6aebf8e3f9414b5d47aca6ec8619b88426c392cf Mon Sep 17 00:00:00 2001
From: Shunhua Lan <lsh@rock-chips.com>
Date: Wed, 11 Aug 2021 12:01:06 +0800
Subject: [PATCH 060/232] media: rk628-for-all: add clk mux for test pin out

Signed-off-by: Shunhua Lan <lsh@rock-chips.com>
Change-Id: I55bbf7ec37c578b901d77566f1391ae7b2157a3b
Signed-off-by: Guochun Huang <hero.huang@rock-chips.com>
---
 drivers/media/i2c/rk628/rk628_cru.c | 15 +++++++++++++++
 drivers/media/i2c/rk628/rk628_cru.h |  1 +
 2 files changed, 16 insertions(+)

diff --git a/drivers/media/i2c/rk628/rk628_cru.c b/drivers/media/i2c/rk628/rk628_cru.c
index 5f3ea4b10f0870..a015b917f568c7 100644
--- a/drivers/media/i2c/rk628/rk628_cru.c
+++ b/drivers/media/i2c/rk628/rk628_cru.c
@@ -404,6 +404,21 @@ static unsigned long rk628_cru_clk_set_rate_sclk_uart(struct rk628 *rk628,
 	return rate;
 }
 
+void rk628_clk_mux_testout(struct rk628 *rk628, int id)
+{
+	switch (id) {
+	case CGU_CLK_CPLL:
+		rk628_i2c_write(rk628, CRU_CLKSEL_CON06, 0x000f0004);
+		break;
+	case CGU_CLK_GPLL:
+		rk628_i2c_write(rk628, CRU_CLKSEL_CON06, 0x000f0002);
+		break;
+	case CGU_CLK_HDMIRX_AUD:
+		rk628_i2c_write(rk628, CRU_CLKSEL_CON06, 0x000f000b);
+		break;
+	}
+}
+
 int rk628_clk_set_rate(struct rk628 *rk628, unsigned int id,
 		       unsigned long rate)
 {
diff --git a/drivers/media/i2c/rk628/rk628_cru.h b/drivers/media/i2c/rk628/rk628_cru.h
index 5904015603bcc9..6970e894ce06e4 100644
--- a/drivers/media/i2c/rk628/rk628_cru.h
+++ b/drivers/media/i2c/rk628/rk628_cru.h
@@ -185,5 +185,6 @@ int rk628_clk_set_rate(struct rk628 *rk628, unsigned int id,
 int rk628_control_assert(struct rk628 *rk628, unsigned long id);
 int rk628_control_deassert(struct rk628 *rk628, unsigned long id);
 void rk628_cru_initialize(struct rk628 *rk628);
+void rk628_clk_mux_testout(struct rk628 *rk628, int id);
 
 #endif
-- 
2.17.1

