+static void rk628_dsi_enable(struct v4l2_subdev *sd)
+{
+	struct rk628_csi *csi = to_csi(sd);
+
+	rk628_post_process_setup(sd);
+
+	if (csi->txphy_pwron) {
+		v4l2_dbg(1, debug, sd,
+			"%s: txphy already power on, power off\n", __func__);
+		mipi_dphy_power_off(csi);
+		csi->txphy_pwron = false;
+	}
