+static void rk628_csi_isr_ctsn(struct v4l2_subdev *sd, u32 pdec_ints)
+{
+	struct rk628_bt1120 *bt1120 = to_bt1120(sd);
+	u32 ctsn_mask = ACR_N_CHG_ICLR | ACR_CTS_CHG_ICLR;
+
+	v4l2_dbg(1, debug, sd, "%s: pdec_ints:%#x\n", __func__, pdec_ints);
+	/* cts & n both need update but maybe come diff int */
+	if (pdec_ints & ACR_N_CHG_ICLR)
+		bt1120->audio_state.ctsn_flag |= ACR_N_CHG_ICLR;
+	if (pdec_ints & ACR_CTS_CHG_ICLR)
+		bt1120->audio_state.ctsn_flag |= ACR_CTS_CHG_ICLR;
+	if (bt1120->audio_state.ctsn_flag == ctsn_mask) {
+		v4l2_dbg(1, debug, sd, "%s: ctsn updated, disable ctsn int\n", __func__);
+		rk628_i2c_write(bt1120->rk628, HDMI_RX_PDEC_IEN_CLR, ctsn_mask);
+		bt1120->ctsn_ints_en = false;
+		schedule_delayed_work(&bt1120->delayed_work_audio_rate_change, 0);
+	}
+	rk628_i2c_write(bt1120->rk628, HDMI_RX_PDEC_ICLR, pdec_ints & ctsn_mask);
+}
