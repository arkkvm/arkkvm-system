+static int get_audio_sampling_rate(struct v4l2_subdev *sd)
+{
+	struct rk628_csi *csi = to_csi(sd);
+
+	if (no_signal(sd))
+		return 0;
+
+	return rk628_hdmirx_audio_fs(csi->audio_info);
+}
