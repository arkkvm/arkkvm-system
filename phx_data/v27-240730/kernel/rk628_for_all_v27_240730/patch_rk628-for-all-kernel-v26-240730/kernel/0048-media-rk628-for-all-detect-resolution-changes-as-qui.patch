From 914f01cbb45bf2b3039badc2b0997d4af9961945 Mon Sep 17 00:00:00 2001
From: Shunqing Chen <csq@rock-chips.com>
Date: Fri, 6 Aug 2021 11:35:57 +0800
Subject: [PATCH 048/232] media: rk628-for-all: detect resolution changes as
 quickly as possible

Signed-off-by: Shunqing Chen <csq@rock-chips.com>
Change-Id: Ia9c4f90be8fade67647263121fc30a7fd3a7bb0f
Signed-off-by: Guochun Huang <hero.huang@rock-chips.com>
---
 drivers/media/i2c/rk628/rk628_bt1120_v4l2.c | 24 ++++++++++++++-------
 drivers/media/i2c/rk628/rk628_csi.c         | 24 ++++++++++++++-------
 2 files changed, 32 insertions(+), 16 deletions(-)

diff --git a/drivers/media/i2c/rk628/rk628_bt1120_v4l2.c b/drivers/media/i2c/rk628/rk628_bt1120_v4l2.c
index 6f26c3f9d49200..3a780002d60163 100644
--- a/drivers/media/i2c/rk628/rk628_bt1120_v4l2.c
+++ b/drivers/media/i2c/rk628/rk628_bt1120_v4l2.c
@@ -41,7 +41,7 @@ static int debug;
 module_param(debug, int, 0644);
 MODULE_PARM_DESC(debug, "debug level (0-3)");
 
-#define DRIVER_VERSION			KERNEL_VERSION(0, 0x0, 0x4)
+#define DRIVER_VERSION			KERNEL_VERSION(0, 0x0, 0x5)
 #define RK628_BT1120_NAME		"rk628-bt1120"
 
 #define EDID_NUM_BLOCKS_MAX 		2
@@ -311,12 +311,12 @@ static int rk628_bt1120_get_detected_timings(struct v4l2_subdev *sd,
 	htotal = (val >> 16) & 0xffff;
 	rk628_i2c_read(bt1120->rk628, HDMI_RX_MD_VTL, &val);
 	vtotal = val & 0xffff;
-	rk628_i2c_read(bt1120->rk628, 0x3014c, &val);
+	rk628_i2c_read(bt1120->rk628, HDMI_RX_MD_HT1, &val);
 	hofs_pix = val & 0xffff;
-	rk628_i2c_read(bt1120->rk628, 0x30164, &val);
+	rk628_i2c_read(bt1120->rk628, HDMI_RX_MD_VOL, &val);
 	vbp = (val & 0xffff) + 1;
 
-	rk628_i2c_read(bt1120->rk628, 0x3009c, &val);
+	rk628_i2c_read(bt1120->rk628, HDMI_RX_HDMI_CKM_RESULT, &val);
 	tmdsclk_cnt = val & 0xffff;
 	tmp_data = tmdsclk_cnt;
 	tmp_data = ((tmp_data * MODETCLK_HZ) + MODETCLK_CNT_NUM / 2);
@@ -329,12 +329,12 @@ static int rk628_bt1120_get_detected_timings(struct v4l2_subdev *sd,
 	}
 	fps = (tmds_clk + (htotal * vtotal) / 2) / (htotal * vtotal);
 
-	rk628_i2c_read(bt1120->rk628, 0x30148, &val);
+	rk628_i2c_read(bt1120->rk628, HDMI_RX_MD_HT0, &val);
 	modetclk_cnt_hs = val & 0xffff;
 	hs = (tmdsclk_cnt * modetclk_cnt_hs + MODETCLK_CNT_NUM / 2) /
 		MODETCLK_CNT_NUM;
 
-	rk628_i2c_read(bt1120->rk628, 0x3015c, &val);
+	rk628_i2c_read(bt1120->rk628, HDMI_RX_MD_VSC, &val);
 	modetclk_cnt_vs = val & 0xffff;
 	vs = (tmdsclk_cnt * modetclk_cnt_vs + MODETCLK_CNT_NUM / 2) /
 		MODETCLK_CNT_NUM;
@@ -1166,7 +1166,12 @@ static void rk628_bt1120_enable_interrupts(struct v4l2_subdev *sd, bool en)
 
 	if (en) {
 		rk628_i2c_write(bt1120->rk628, HDMI_RX_MD_IEN_SET,
-				VACT_LIN_ENSET | HACT_PIX_ENSET);
+				VACT_LIN_ENSET |
+				HACT_PIX_ENSET |
+				HS_CLK_ENSET |
+				DE_ACTIVITY_ENSET |
+				VS_ACT_ENSET |
+				HS_ACT_ENSET);
 		rk628_i2c_write(bt1120->rk628, HDMI_RX_PDEC_IEN_SET, AVI_RCV_ENSET);
 	} else {
 		rk628_i2c_write(bt1120->rk628, HDMI_RX_MD_IEN_CLR, 0xffffffff);
@@ -1197,7 +1202,10 @@ static int rk628_bt1120_isr(struct v4l2_subdev *sd, u32 status, bool *handled)
 	v4l2_dbg(1, debug, sd, "%s: md_ints: %#x, pdec_ints:%#x, plugin: %d\n",
 		__func__, md_ints, pdec_ints, plugin);
 
-	if ((md_ints & (VACT_LIN_ISTS | HACT_PIX_ISTS)) && plugin) {
+	if ((md_ints & (VACT_LIN_ISTS | HACT_PIX_ISTS |
+			HS_CLK_ISTS | DE_ACTIVITY_ISTS |
+			VS_ACT_ISTS | HS_ACT_ISTS))
+			&& plugin) {
 		rk628_i2c_read(bt1120->rk628, HDMI_RX_MD_HACT_PX, &hact);
 		rk628_i2c_read(bt1120->rk628, HDMI_RX_MD_VAL, &vact);
 		v4l2_dbg(1, debug, sd, "%s: HACT:%#x, VACT:%#x\n",
diff --git a/drivers/media/i2c/rk628/rk628_csi.c b/drivers/media/i2c/rk628/rk628_csi.c
index ed89220a701612..23eec453984c90 100644
--- a/drivers/media/i2c/rk628/rk628_csi.c
+++ b/drivers/media/i2c/rk628/rk628_csi.c
@@ -42,7 +42,7 @@ static int debug;
 module_param(debug, int, 0644);
 MODULE_PARM_DESC(debug, "debug level (0-1)");
 
-#define DRIVER_VERSION			KERNEL_VERSION(0, 0x0, 0x4)
+#define DRIVER_VERSION			KERNEL_VERSION(0, 0x0, 0x5)
 
 #define EDID_NUM_BLOCKS_MAX 		2
 #define EDID_BLOCK_SIZE 		128
@@ -359,12 +359,12 @@ static int rk628_csi_get_detected_timings(struct rk628_csi *csi,
 	htotal = (val >> 16) & 0xffff;
 	rk628_i2c_read(csi->rk628, HDMI_RX_MD_VTL, &val);
 	vtotal = val & 0xffff;
-	rk628_i2c_read(csi->rk628, 0x3014c, &val);
+	rk628_i2c_read(csi->rk628, HDMI_RX_MD_HT1, &val);
 	hofs_pix = val & 0xffff;
-	rk628_i2c_read(csi->rk628, 0x30164, &val);
+	rk628_i2c_read(csi->rk628, HDMI_RX_MD_VOL, &val);
 	vbp = (val & 0xffff) + 1;
 
-	rk628_i2c_read(csi->rk628, 0x3009c, &val);
+	rk628_i2c_read(csi->rk628, HDMI_RX_HDMI_CKM_RESULT, &val);
 	tmdsclk_cnt = val & 0xffff;
 	tmp_data = tmdsclk_cnt;
 	tmp_data = ((tmp_data * MODETCLK_HZ) + MODETCLK_CNT_NUM / 2);
@@ -377,12 +377,12 @@ static int rk628_csi_get_detected_timings(struct rk628_csi *csi,
 	}
 	fps = (tmds_clk + (htotal * vtotal) / 2) / (htotal * vtotal);
 
-	rk628_i2c_read(csi->rk628, 0x30148, &val);
+	rk628_i2c_read(csi->rk628, HDMI_RX_MD_HT0, &val);
 	modetclk_cnt_hs = val & 0xffff;
 	hs = (tmdsclk_cnt * modetclk_cnt_hs + MODETCLK_CNT_NUM / 2) /
 		MODETCLK_CNT_NUM;
 
-	rk628_i2c_read(csi->rk628, 0x3015c, &val);
+	rk628_i2c_read(csi->rk628, HDMI_RX_MD_VSC, &val);
 	modetclk_cnt_vs = val & 0xffff;
 	vs = (tmdsclk_cnt * modetclk_cnt_vs + MODETCLK_CNT_NUM / 2) /
 		MODETCLK_CNT_NUM;
@@ -1234,7 +1234,12 @@ static void rk628_csi_enable_interrupts(struct rk628_csi *csi, bool en)
 
 	if (en) {
 		rk628_i2c_write(csi->rk628, HDMI_RX_MD_IEN_SET,
-				VACT_LIN_ENSET | HACT_PIX_ENSET);
+				VACT_LIN_ENSET |
+				HACT_PIX_ENSET |
+				HS_CLK_ENSET |
+				DE_ACTIVITY_ENSET |
+				VS_ACT_ENSET |
+				HS_ACT_ENSET);
 		rk628_i2c_write(csi->rk628, HDMI_RX_PDEC_IEN_SET, AVI_RCV_ENSET);
 	} else {
 		rk628_i2c_write(csi->rk628, HDMI_RX_MD_IEN_CLR, 0xffffffff);
@@ -1264,7 +1269,10 @@ static int rk628_csi_isr(struct rk628_csi *csi, u32 status, bool *handled)
 	dev_dbg(csi->dev, "%s: md_ints: %#x, pdec_ints:%#x, plugin: %d\n",
 		__func__, md_ints, pdec_ints, plugin);
 
-	if ((md_ints & (VACT_LIN_ISTS | HACT_PIX_ISTS)) && plugin) {
+	if ((md_ints & (VACT_LIN_ISTS | HACT_PIX_ISTS |
+			HS_CLK_ISTS | DE_ACTIVITY_ISTS |
+			VS_ACT_ISTS | HS_ACT_ISTS))
+			&& plugin) {
 		rk628_i2c_read(csi->rk628, HDMI_RX_MD_HACT_PX, &hact);
 		rk628_i2c_read(csi->rk628, HDMI_RX_MD_VAL, &vact);
 		dev_dbg(csi->dev, "%s: HACT:%#x, VACT:%#x\n",
-- 
