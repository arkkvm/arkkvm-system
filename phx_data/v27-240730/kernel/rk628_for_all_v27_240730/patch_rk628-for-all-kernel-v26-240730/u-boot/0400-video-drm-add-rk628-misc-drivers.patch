diff --git a/drivers/video/drm/rk628/rk628_hdmirx.c b/drivers/video/drm/rk628/rk628_hdmirx.c
new file mode 100644
index 00000000000..55dd384e5a5
--- /dev/null
+++ b/drivers/video/drm/rk628/rk628_hdmirx.c
@@ -0,0 +1,548 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright (C) 2020 Rockchip Electronics Co., Ltd
