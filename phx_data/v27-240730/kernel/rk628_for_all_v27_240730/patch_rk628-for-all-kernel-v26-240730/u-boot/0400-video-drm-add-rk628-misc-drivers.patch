+static bool is_rgb_format(u64 format)
+{
+	switch (format) {
+	case BUS_FMT_YUV420:
+	case BUS_FMT_YUV422:
+	case BUS_FMT_YUV444:
+		return false;
+	case BUS_FMT_RGB:
