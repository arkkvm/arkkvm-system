+static inline bool no_signal(struct v4l2_subdev *sd)
+{
+	struct rk628_csi *csi = to_csi(sd);
+
+	v4l2_dbg(1, debug, sd, "%s no signal:%d\n", __func__, csi->nosignal);
+	return csi->nosignal;
+}
