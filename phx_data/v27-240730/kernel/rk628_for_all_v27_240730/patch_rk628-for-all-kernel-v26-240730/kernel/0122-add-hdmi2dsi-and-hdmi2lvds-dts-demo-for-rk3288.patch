From cd4bc83a12076150f5b292e9efe467a77df110f4 Mon Sep 17 00:00:00 2001
From: Luo Wei <lw@rock-chips.com>
Date: Wed, 24 Nov 2021 09:48:35 +0800
Subject: [PATCH 122/232] add hdmi2dsi and hdmi2lvds dts demo for rk3288

Signed-off-by: Luo Wei <lw@rock-chips.com>
Change-Id: I2c1a95c6a920d4ebb0e971911dc77d75d1832127
Signed-off-by: Guochun Huang <hero.huang@rock-chips.com>
---
 .../rk3288-evb-rk628-misc-hdmi2dsi-avb.dts    | 136 ++++++++++++++++++
 ...3288-evb-rk628-misc-hdmi2lvds-dual-avb.dts |  75 ++++++++++
 2 files changed, 211 insertions(+)
 create mode 100644 arch/arm/boot/dts/rk3288-evb-rk628-misc-hdmi2dsi-avb.dts
 create mode 100644 arch/arm/boot/dts/rk3288-evb-rk628-misc-hdmi2lvds-dual-avb.dts

diff --git a/arch/arm/boot/dts/rk3288-evb-rk628-misc-hdmi2dsi-avb.dts b/arch/arm/boot/dts/rk3288-evb-rk628-misc-hdmi2dsi-avb.dts
new file mode 100644
index 00000000000000..41c2bd7080a82b
--- /dev/null
+++ b/arch/arm/boot/dts/rk3288-evb-rk628-misc-hdmi2dsi-avb.dts
@@ -0,0 +1,136 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+// Copyright (c) 2020 Fuzhou Rockchip Electronics Co., Ltd
+
+/dts-v1/;
+#include "rk3288-evb-rk628.dtsi"
+
+/ {
+	model = "Rockchip RK3288 EVB RK628 Board";
+	compatible = "rockchip,rk3288-evb-rk628", "rockchip,rk3288";
+
+	chosen {
+		bootargs = "rootwait earlycon=uart8250,mmio32,0xff690000 vmalloc=496M swiotlb=1 console=ttyFIQ0 androidboot.baseband=N/A androidboot.veritymode=enforcing androidboot.hardware=rk30board androidboot.console=ttyFIQ0 init=/init kpti=0";
+	};
+	panel {
+		compatible = "simple-panel";
+		backlight = <&backlight>;
+		//enable-gpios = <&gpio7 RK_PA2 GPIO_ACTIVE_HIGH>;
+		prepare-delay-ms = <120>;
+		enable-delay-ms = <120>;
+		disable-delay-ms = <120>;
+		unprepare-delay-ms = <20>;
+		status = "okay";
+
+		display-timings {
+			native-mode = <&timing0>;
+
+			timing0: timing0 {
+				clock-frequency = <132000000>;
+				hactive = <1080>;
+				vactive = <1920>;
+				hback-porch = <30>;
+				hfront-porch = <15>;
+				vback-porch = <15>;
+				vfront-porch = <15>;
+				hsync-len = <2>;
+				vsync-len = <2>;
+				hsync-active = <0>;
+				vsync-active = <0>;
+				de-active = <0>;
+				pixelclk-active = <0>;
+			};
+		};
+
+		port {
+			panel_in_lvds: endpoint {
+				remote-endpoint = <&lvds_out_panel>;
+			};
+		};
+	};
+
+};
+
+&firmware_android {
+	compatible = "android,firmware";
+	boot_devices = "ff0f0000.dwmmc";
+
+	vbmeta {
+		compatible = "android,vbmeta";
+		parts = "vbmeta,boot,system,vendor,dtbo";
+	};
+
+	fstab {
+		compatible = "android,fstab";
+
+		vendor {
+			compatible = "android,vendor";
+			dev = "/dev/block/by-name/vendor";
+			type = "ext4";
+			mnt_flags = "ro,barrier=1,inode_readahead_blks=8";
+			fsmgr_flags = "wait,avb";
+		};
+	};
+};
+
+&rgb {
+	status = "disabled";
+
+	ports {
+		port@1 {
+			reg = <1>;
+
+			lvds_out_panel: endpoint {
+				remote-endpoint = <&panel_in_lvds>;
+			};
+		};
+	};
+};
+
+&i2c1 {
+	clock-frequency = <400000>;
+	status = "okay";
+
+	rk628: rk628@50 {
+		compatible = "rockchip,rk628";
+		reg = <0x50>;
+		interrupt-parent = <&gpio7>;
+		interrupts = <15 IRQ_TYPE_LEVEL_HIGH>;
+		enable-gpios = <&gpio5 RK_PC2 GPIO_ACTIVE_HIGH>;
+		reset-gpios = <&gpio7 RK_PB6 GPIO_ACTIVE_LOW>;
+		panel-enable-gpios = <&gpio7 RK_PA2 GPIO_ACTIVE_HIGH>;
+		status = "okay";
+	};
+};
+
+&video_phy {
+	status = "okay";
+};
+
+&rgb_in_vopb {
+	status = "disabled";
+};
+
+&rgb_in_vopl {
+	status = "okay";
+};
+
+&route_rgb {
+	connect = <&vopl_out_rgb>;
+	status = "okay";
+};
+
+&hdmi {
+	status = "okay";
+};
+
+&hdmi_in_vopb {
+	status = "okay";
+};
+
+&hdmi_in_vopl {
+	status = "disabled";
+};
+
+&route_hdmi {
+	status = "disabled";
+};
