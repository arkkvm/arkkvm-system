+#define HDMI_RX_HDMI_ERD_STS      	(HDMI_RX_BASE + 0x0088)
+#define HDMI_RX_HDMI_SYNC_CTRL      	(HDMI_RX_BASE + 0x0090)
+#define VS_POL_ADJ_MODE_MASK       	GENMASK(4, 3)
+#define VS_POL_ADJ_MODE(x)		UPDATE(x, 4, 3)
