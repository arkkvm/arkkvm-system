From c195d762976b92ed134c51c2f97bd3eb146a49a4 Mon Sep 17 00:00:00 2001
From: Shunqing Chen <csq@rock-chips.com>
Date: Wed, 4 Aug 2021 19:29:46 +0800
Subject: [PATCH 051/232] media: rk628-for-all: csi_v4l2: fix the issue of no
 display

Signed-off-by: Shunqing Chen <csq@rock-chips.com>
Change-Id: Icd643553e376cf5a74925cbbc6eabe56eb1e8009
Signed-off-by: Guochun Huang <hero.huang@rock-chips.com>
---
 drivers/media/i2c/rk628/rk628_csi_v4l2.c | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/drivers/media/i2c/rk628/rk628_csi_v4l2.c b/drivers/media/i2c/rk628/rk628_csi_v4l2.c
index adb7c09e02bd2a..5c842e34dbda4e 100644
--- a/drivers/media/i2c/rk628/rk628_csi_v4l2.c
+++ b/drivers/media/i2c/rk628/rk628_csi_v4l2.c
@@ -949,7 +949,7 @@ static void rk628_csi_set_csi(struct v4l2_subdev *sd)
 
 	for (i = 0; i < 100; i++) {
 		rk628_i2c_read(csi->rk628, HDMI_RX_PDEC_AVI_PB, &val);
-		v4l2_dbg(2, debug, sd, "%s PDEC_AVI_PB:%#x, avi_rcv_rdy:%d\n",
+		dev_info(csi->dev, "%s PDEC_AVI_PB:%#x, avi_rcv_rdy:%d\n",
 			 __func__, val, csi->avi_rcv_rdy);
 		if (i > 30 && !(hdcp_ctrl_val & 0x400)) {
 			rk628_i2c_read(csi->rk628, HDMI_RX_HDCP_CTRL, &hdcp_ctrl_val);
@@ -985,8 +985,10 @@ static void rk628_csi_set_csi(struct v4l2_subdev *sd)
 	}
 
 	/* if avi packet is not stable, reset ctrl*/
-	if (cnt < max_cnt)
+	if (cnt < max_cnt) {
+		csi->nosignal = true;
 		schedule_delayed_work(&csi->delayed_work_enable_hotplug, HZ / 20);
+	}
 }
 
 static int rk628_hdmirx_phy_power_on(struct v4l2_subdev *sd)
@@ -1024,7 +1026,7 @@ static int rk628_hdmirx_phy_power_on(struct v4l2_subdev *sd)
 			csi->rxphy_pwron = true;
 		}
 		rk628_hdmirx_ctrl_enable(sd, 1);
-		msleep(60);
+		msleep(100);
 	}
 
 	return ret;
-- 
2.17.1

