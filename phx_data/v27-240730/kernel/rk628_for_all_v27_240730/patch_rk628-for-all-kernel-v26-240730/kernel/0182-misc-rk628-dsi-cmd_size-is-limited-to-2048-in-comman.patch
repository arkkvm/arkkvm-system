From d21301e9d4ccdcf0b54e07c9f7f7d4afdf9d2386 Mon Sep 17 00:00:00 2001
From: Zhibin Huang <zhibin.huang@rock-chips.com>
Date: Tue, 21 Nov 2023 00:11:30 +0000
Subject: [PATCH 182/232] misc: rk628: dsi: cmd_size is limited to 2048 in
 command mode

Signed-off-by: Zhibin Huang <zhibin.huang@rock-chips.com>
Change-Id: I62a0808cb31860b4713079069b974c0fe4fd3b57
Signed-off-by: Guochun Huang <hero.huang@rock-chips.com>
---
 drivers/misc/rk628/rk628_dsi.c | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/drivers/misc/rk628/rk628_dsi.c b/drivers/misc/rk628/rk628_dsi.c
index dad6e4f507c7c1..bc70f0fae13fd9 100644
--- a/drivers/misc/rk628/rk628_dsi.c
+++ b/drivers/misc/rk628/rk628_dsi.c
@@ -1156,9 +1156,17 @@ static void rk628_dsi_set_cmd_mode(struct rk628 *rk628,
 				   const struct rk628_dsi *dsi,
 				   const struct rk628_display_mode *mode)
 {
+	int cmd_size;
+
 	dsi_update_bits(rk628, dsi, DSI_CMD_MODE_CFG, DCS_LW_TX, 0);
-	dsi_write(rk628, dsi, DSI_EDPI_CMD_SIZE,
-		  EDPI_ALLOWED_CMD_SIZE(mode->hdisplay));
+
+	/* rk628: The maximum capacity of dsi memory is 2048*32 bits */
+	if (mode->hdisplay > 2048)
+		cmd_size = EDPI_ALLOWED_CMD_SIZE(mode->hdisplay / 2);
+	else
+		cmd_size = EDPI_ALLOWED_CMD_SIZE(mode->hdisplay);
+
+	dsi_write(rk628, dsi, DSI_EDPI_CMD_SIZE, cmd_size);
 
 	if (dsi->mode_flags & MIPI_DSI_CLOCK_NON_CONTINUOUS)
 		dsi_update_bits(rk628, dsi, DSI_LPCLK_CTRL,
-- 
