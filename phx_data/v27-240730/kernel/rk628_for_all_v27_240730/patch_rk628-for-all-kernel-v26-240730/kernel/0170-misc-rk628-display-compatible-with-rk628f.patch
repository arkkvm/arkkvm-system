+#define SW_HDMITX_EN(x)			UPDATE(x, 5, 5)
+#define SW_OUTPUT_COMBTX_MODE_MASK	GENMASK(4, 3)
+#define SW_OUTPUT_COMBTX_MODE(x)	UPDATE(x, 4, 3)
+
 #define SW_INPUT_MODE_MASK		GENMASK(2, 0)
 #define SW_INPUT_MODE(x)		UPDATE(x, 2, 0)
