+		usleep_range(10000, 11000);
+	}
+	gpiod_set_value(csi->reset_gpio, 1);
+	usleep_range(10000, 11000);
+	gpiod_set_value(csi->reset_gpio, 0);
+	usleep_range(10000, 11000);
+	gpiod_set_value(csi->reset_gpio, 1);
+	usleep_range(10000, 11000);
+
+	if (csi->power_gpio) {
+		gpiod_set_value(csi->power_gpio, 0);
+		usleep_range(10000, 11000);
+	}
+	clk_disable_unprepare(csi->soc_24M);
+
+	return 0;
