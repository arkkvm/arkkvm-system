-	rk628_clk_set_rate(bt1120->rk628, CGU_CLK_HDMIRX_AUD, hdmirx_aud_clkrate);
-	bt1120->audio_state.hdmirx_aud_clkrate = hdmirx_aud_clkrate;
-}
