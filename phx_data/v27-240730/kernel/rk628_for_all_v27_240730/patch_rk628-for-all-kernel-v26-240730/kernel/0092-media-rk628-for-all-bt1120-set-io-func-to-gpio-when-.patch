From 1af16bebaa4b1a052eac1bcd83bdd508d56876b8 Mon Sep 17 00:00:00 2001
From: Shunqing Chen <csq@rock-chips.com>
Date: Fri, 10 Sep 2021 17:21:49 +0800
Subject: [PATCH 092/232] media: rk628-for-all: bt1120: set io func to gpio
 when plugout

Signed-off-by: Shunqing Chen <csq@rock-chips.com>
Change-Id: I45d6b328fe3d8c46de21b05ba92d184694d44624
Signed-off-by: Guochun Huang <hero.huang@rock-chips.com>
---
 drivers/media/i2c/rk628/rk628_bt1120_v4l2.c | 23 ++++++++++++++++-----
 1 file changed, 18 insertions(+), 5 deletions(-)

diff --git a/drivers/media/i2c/rk628/rk628_bt1120_v4l2.c b/drivers/media/i2c/rk628/rk628_bt1120_v4l2.c
index d81ab46f7d6d59..362c88da4864b7 100644
--- a/drivers/media/i2c/rk628/rk628_bt1120_v4l2.c
+++ b/drivers/media/i2c/rk628/rk628_bt1120_v4l2.c
@@ -438,6 +438,22 @@ static void rk628_hdmirx_reset_regfile(struct v4l2_subdev *sd)
 		rk628_hdmirx_hpd_ctrl(sd, true);
 }
 
+static void rk628_set_io_func_to_vop(struct rk628 *rk628)
+{
+	/* pinctrl for vop pin */
+	rk628_i2c_write(rk628, GRF_GPIO2AB_SEL_CON, 0xffffffff);
+	rk628_i2c_write(rk628, GRF_GPIO2C_SEL_CON, 0xffff5555);
+	rk628_i2c_write(rk628, GRF_GPIO3AB_SEL_CON, 0x10b010b);
+}
+
+static void rk628_set_io_func_to_gpio(struct rk628 *rk628)
+{
+	/* pinctrl for gpio */
+	rk628_i2c_write(rk628, GRF_GPIO2AB_SEL_CON, 0xffff0000);
+	rk628_i2c_write(rk628, GRF_GPIO2C_SEL_CON, 0xffff0000);
+	rk628_i2c_write(rk628, GRF_GPIO3AB_SEL_CON, 0x0fff0000);
+}
+
 static void rk628_bt1120_delayed_work_enable_hotplug(struct work_struct *work)
 {
 	struct delayed_work *dwork = to_delayed_work(work);
@@ -451,6 +467,7 @@ static void rk628_bt1120_delayed_work_enable_hotplug(struct work_struct *work)
 	plugin = tx_5v_power_present(sd);
 	v4l2_dbg(1, debug, sd, "%s: 5v_det:%d\n", __func__, plugin);
 	if (plugin) {
+		rk628_set_io_func_to_vop(bt1120->rk628);
 		rk628_bt1120_enable_interrupts(sd, false);
 		rk628_hdmirx_audio_setup(bt1120->audio_info);
 		rk628_hdmirx_set_hdcp(bt1120->rk628, &bt1120->hdcp, bt1120->enable_hdcp);
@@ -468,6 +485,7 @@ static void rk628_bt1120_delayed_work_enable_hotplug(struct work_struct *work)
 		rk628_hdmirx_phy_power_off(sd);
 		rk628_hdmirx_controller_reset(sd);
 		bt1120->nosignal = true;
+		rk628_set_io_func_to_gpio(bt1120->rk628);
 	}
 	mutex_unlock(&bt1120->confctl_mutex);
 }
@@ -1057,11 +1075,6 @@ static void rk628_bt1120_initial_setup(struct v4l2_subdev *sd)
 	rk628_control_deassert(bt1120->rk628, RGU_BT1120DEC);
 	udelay(10);
 
-	/* pinctrl for vop pin */
-	rk628_i2c_write(bt1120->rk628, GRF_GPIO2AB_SEL_CON, 0xffffffff);
-	rk628_i2c_write(bt1120->rk628, GRF_GPIO2C_SEL_CON, 0xffff5555);
-	rk628_i2c_write(bt1120->rk628, GRF_GPIO3AB_SEL_CON, 0x10b010b);
-
 	rk628_i2c_update_bits(bt1120->rk628, GRF_SYSTEM_CON0,
 			SW_BT_DATA_OEN_MASK |
 			SW_INPUT_MODE_MASK |
-- 
2.17.1

