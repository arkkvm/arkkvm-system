From 709541945937ace9ecc066faabff36f82c49f790 Mon Sep 17 00:00:00 2001
From: Guochun Huang <hero.huang@rock-chips.com>
Date: Fri, 6 Aug 2021 17:19:21 +0800
Subject: [PATCH 075/232] media: i2c: rk628: compatible with MCU mode

Signed-off-by: Guochun Huang <hero.huang@rock-chips.com>
Change-Id: I8fdd2ae4421debd256a4d23d279ee2b7b93c5186
---
 drivers/misc/rk628/rk628.h     | 2 ++
 drivers/misc/rk628/rk628_cru.c | 8 ++++++++
 2 files changed, 10 insertions(+)

diff --git a/drivers/misc/rk628/rk628.h b/drivers/misc/rk628/rk628.h
index b2ee9cf8cf4730..ecceb761e5a1f3 100755
--- a/drivers/misc/rk628/rk628.h
+++ b/drivers/misc/rk628/rk628.h
@@ -184,6 +184,8 @@
 #define GRF_INTR1_STATUS		0x0118
 #define GRF_INTR1_RAW_STATUS		0x011c
 #define GRF_SYSTEM_STATUS0		0x0120
+/* 0: i2c mode and mcu mode; 1: i2c mode only */
+#define I2C_ONLY_FLAG			BIT(6)
 #define GRF_SYSTEM_STATUS3		0x012c
 #define GRF_SYSTEM_STATUS4		0x0130
 #define GRF_OS_REG0			0x0140
diff --git a/drivers/misc/rk628/rk628_cru.c b/drivers/misc/rk628/rk628_cru.c
index 3dc75cf7dc9d65..feb3878fd63110 100644
--- a/drivers/misc/rk628/rk628_cru.c
+++ b/drivers/misc/rk628/rk628_cru.c
@@ -412,6 +412,14 @@ unsigned long rk628_cru_clk_get_rate(struct rk628 *rk628, unsigned int id)
 
 void rk628_cru_init(struct rk628 *rk628)
 {
+	u32 val;
+	u8 mcu_mode;
+
+	rk628_i2c_read(rk628, GRF_SYSTEM_STATUS0, &val);
+	mcu_mode = (val & I2C_ONLY_FLAG) ? 0 : 1;
+	if (mcu_mode)
+		return;
+
 	rk628_i2c_write(rk628, CRU_GPLL_CON0, 0xffff701d);
 	mdelay(1);
 	rk628_i2c_write(rk628, CRU_MODE_CON00, 0xffff0004);
-- 
