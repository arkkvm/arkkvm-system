From 1121741f3196a4210d4d8d7fbc3799a131bc8e9a Mon Sep 17 00:00:00 2001
From: Sandy Huang <hjc@rock-chips.com>
Date: Tue, 7 Nov 2023 10:26:15 +0800
Subject: [PATCH 180/232] misc: rk628: gvi: add color depth config

Signed-off-by: Sandy Huang <hjc@rock-chips.com>
Change-Id: I0faab0e23cb8b22cd5c31a4bf60a1571acae0818
Signed-off-by: Guochun Huang <hero.huang@rock-chips.com>
---
 drivers/misc/rk628/rk628_gvi.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/drivers/misc/rk628/rk628_gvi.c b/drivers/misc/rk628/rk628_gvi.c
index 13468f218e5592..23ff0c34fa9824 100644
--- a/drivers/misc/rk628/rk628_gvi.c
+++ b/drivers/misc/rk628/rk628_gvi.c
@@ -136,6 +136,9 @@ static void rk628_gvi_pre_enable(struct rk628 *rk628, struct rk628_gvi *gvi)
 	rk628_i2c_update_bits(rk628, GVI_SYS_CTRL0, SYS_CTRL0_FRM_RST_EN,
 			      gvi->frm_rst ? SYS_CTRL0_FRM_RST_EN : 0);
 	rk628_i2c_update_bits(rk628, GVI_SYS_CTRL1, SYS_CTRL1_LANE_ALIGN_EN, 0);
+
+	rk628_i2c_update_bits(rk628, GVI_SYS_CTRL1, SYS_CTRL1_COLOR_DEPTH_MASK,
+			      SYS_CTRL1_COLOR_DEPTH(gvi->color_depth));
 }
 
 static void rk628_gvi_enable_color_bar(struct rk628 *rk628,
-- 
