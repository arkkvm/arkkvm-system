# network-config-unified default paths
# Override via config/local.env or environment variables

NET_IF=eth0

# Sole config file (ArkKVM simplified scheme: app layer only reads/writes this file)
NETWORK_CONF=/userdata/arkkvm/network.conf
NETWORK_CONF_PENDING=/userdata/arkkvm/network.conf.pending
NETWORK_CONF_ROLLBACK=/userdata/arkkvm/network.conf.rollback
NETWORK_CONF_PENDING_MARKER=/userdata/arkkvm/network.conf.pending-active

# System paths
RESOLV_CONF=/etc/resolv.conf
HOSTNAME_FILE=/etc/hostname
HOSTS_FILE=/etc/hosts
NETWORK_LOG=/userdata/arkkvm/network.log

# Lease info (both DHCP backends write this format)
LEASE_FILE=/run/udhcpc.%s.info

# Refresh / DHCP retry coordination
NWU_REFRESH_LOCK=/run/arkkvm-network.refresh.lock
NWU_DHCP_RETRY_PID=/run/arkkvm-network.dhcp-retry.pid
NWU_DHCP_RETRY_GEN=/run/arkkvm-network.dhcp-retry.gen
NWU_DHCP_RETRY_INTERVAL=8

# udhcpc
UDHCPC_SCRIPT=/usr/share/udhcpc/default.script

# dhcpcd
DHCPCD_CONF=/etc/dhcpcd.conf
DHCPCD_PIDFILE=/var/run/dhcpcd/pid
# Persistent lease DB from legacy S15dhcpcd (OTA → udhcpc uses yiaddr for -r)
DHCPCD_DB=/userdata/arkkvm/dhcpcd
# Last successfully bound IPv4 (OTA/reboot prefer source)
LAST_DHCP_DIR=/userdata/arkkvm/last_dhcp

# Local test root (path redirection for ctl test)
TEST_ROOT=
