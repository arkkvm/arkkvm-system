+static void enable_bt1120tx(struct v4l2_subdev *sd)
+{
+	struct rk628_bt1120 *bt1120 = to_bt1120(sd);
+	u8 i, video_fmt;
+	u8 lanes = bt1120->bt1120_lanes_in_use;
+	u8 lane_num;
+	u8 dphy_lane_en;
+	u32 wc_usrdef, val = 0, avi_pb = 0;
+	u8 cnt = 0;
+
+	lane_num = lanes - 1;
+	dphy_lane_en = (1 << (lanes + 1)) - 1;
+	wc_usrdef = bt1120->timings.bt.width * 2;
+
+	rk628_post_process_setup(sd);
+
+	rk628_i2c_update_bits(GRF_POST_PROC_CON,
+			   SW_DCLK_OUT_INV_EN, SW_DCLK_OUT_INV_EN);
+
+	if (bt1120->dual_edge) {
+		val |= ENC_DUALEDGE_EN(1);
+		rk628_i2c_write(GRF_BT1120_DCLK_DELAY_CON0, 0x10000000);
+		rk628_i2c_write(GRF_BT1120_DCLK_DELAY_CON1, 0);
+	}
+
+	val |= BT1120_UV_SWAP(0);
+	rk628_i2c_write(GRF_RGB_ENC_CON, val);
+	v4l2_dbg(1, debug, sd, "%s bt1120 cofig done\n", __func__);
+
+	for (i = 0; i < 100; i++) {
+		rk628_i2c_read(HDMI_RX_PDEC_AVI_PB, &val);
+		v4l2_dbg(2, debug, sd, "%s PDEC_AVI_PB:%#x, avi_rcv_rdy:%d\n",
+			 __func__, val, bt1120->avi_rcv_rdy);
+		if (val == avi_pb && bt1120->avi_rcv_rdy) {
+			if (++cnt >= 2)
+				break;
+		} else {
+			cnt = 0;
+			avi_pb = val;
+		}
+		msleep(30);
+	}
+	video_fmt = (val & VIDEO_FORMAT_MASK) >> 5;
+	v4l2_dbg(1, debug, &bt1120->sd, "%s PDEC_AVI_PB:%#x, video format:%d\n",
+			__func__, val, video_fmt);
+	if (video_fmt) {
+		/* yuv data: cfg SW_YUV2VYU_SWP */
+		rk628_i2c_write(GRF_CSC_CTRL_CON,
+				SW_YUV2VYU_SWP(1) |
+				SW_R2Y_EN(0));
+	} else {
+		/* rgb data: cfg SW_R2Y_EN */
+		rk628_i2c_write(GRF_CSC_CTRL_CON,
+				SW_YUV2VYU_SWP(0) |
+				SW_R2Y_EN(1));
+	}
+}
