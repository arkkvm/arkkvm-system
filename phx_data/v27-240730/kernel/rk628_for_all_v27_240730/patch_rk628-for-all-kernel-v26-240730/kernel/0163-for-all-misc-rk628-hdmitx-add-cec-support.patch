+static unsigned long rk628_cru_clk_get_rate_pclk_logic(struct rk628 *rk628)
+{
+	unsigned long rate;
+	u64 parent_rate;
+	u8 div;
+	u32 val;
+
+	rk628_i2c_read(rk628, CRU_CLKSEL_CON00, &val);
+	if (val & PCLK_LOGIC_SEL_MASK)
+		parent_rate = rk628_cru_clk_get_rate_pll(rk628, CGU_CLK_GPLL);
+	else
+		parent_rate = rk628_cru_clk_get_rate_pll(rk628, CGU_CLK_CPLL);
+	div = (val & 0x1f) + 1;
+	do_div(parent_rate, div);
+	rate = parent_rate;
+
+	return rate;
+}
+
 static unsigned long rk628_cru_clk_get_rate_uart_src(struct rk628 *rk628)
 {
 	unsigned long rate, parent_rate;
@@ -434,6 +453,10 @@ unsigned long rk628_cru_clk_get_rate(struct rk628 *rk628, unsigned int id)
 	case CGU_SCLK_VOP:
 		rate = rk628_cru_clk_get_rate_sclk_vop(rk628);
 		break;
+	case CGU_PCLK_HDMITX:
+	case CGU_PCLK_LOGIC:
+		rate = rk628_cru_clk_get_rate_pclk_logic(rk628);
+		break;
 	default:
 		return 0;
 	}
