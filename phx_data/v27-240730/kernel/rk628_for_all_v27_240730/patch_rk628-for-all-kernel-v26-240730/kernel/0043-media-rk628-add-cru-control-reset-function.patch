+#define RGU_HDMITX		20
+#define RGU_GVIHOST		21
+#define RGU_DSI0		22
+#define RGU_DSI1		23
+#define RGU_CSI			24
+#define RGU_TXDATA		25
+#define RGU_DECODER		26
+#define RGU_ENCODER		27
