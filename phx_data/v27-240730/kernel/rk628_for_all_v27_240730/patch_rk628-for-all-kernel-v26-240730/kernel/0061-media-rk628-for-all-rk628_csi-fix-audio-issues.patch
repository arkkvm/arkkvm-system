+	rk628_i2c_write(csi->rk628, HDMI_RX_AUD_FIFO_CTRL, 0x10000);
+	rk628_i2c_update_bits(csi->rk628, HDMI_RX_AUD_FIFO_TH,
+			   AFIF_TH_START_MASK,
+			   AFIF_TH_START(INIT_FIFO_STATE));
+	csi->audio_state.pre_state = csi->audio_state.init_state = INIT_FIFO_STATE*4;
