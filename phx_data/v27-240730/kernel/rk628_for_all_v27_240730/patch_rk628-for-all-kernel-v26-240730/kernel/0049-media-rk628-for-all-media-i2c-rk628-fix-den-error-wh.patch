 	for (i = 0; i < 100; i++) {
 		rk628_i2c_read(csi->rk628, HDMI_RX_PDEC_AVI_PB, &val);
 		dev_dbg(csi->dev, "%s PDEC_AVI_PB:%#x, avi_rcv_rdy:%d\n",
 			 __func__, val, csi->avi_rcv_rdy);
-		if (val == avi_pb && csi->avi_rcv_rdy) {
-			if (++cnt >= 2)
