+#define RGU_CRU			1
+#define RGU_REGFILE		2
+#define RGU_I2C2APB		3
+#define RGU_EFUSE		4
+#define RGU_ADAPTER		5
+#define RGU_CLK_RX		6
+#define RGU_BT1120DEC		7
+#define RGU_VOP			8
+#define RGU_GPIO0		9
+#define RGU_GPIO1		10
+#define RGU_GPIO2		11
+#define RGU_GPIO3		12
+#define RGU_GPIO_DB0		13
+#define RGU_GPIO_DB1		14
+#define RGU_GPIO_DB2		15
+#define RGU_GPIO_DB3		16
+#define RGU_RXPHY		17
+#define RGU_HDMIRX		18
