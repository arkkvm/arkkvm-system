From 4b837b3aa2ed5513e69f537bbba0748bc6b20f7b Mon Sep 17 00:00:00 2001
From: Guochun Huang <hero.huang@rock-chips.com>
Date: Wed, 20 Oct 2021 12:30:27 +0800
Subject: [PATCH 114/232] misc: rk628-for-all: add suspend/resume helper

Signed-off-by: Guochun Huang <hero.huang@rock-chips.com>
Change-Id: Idac1ff50e6991250b43505c8631d775692bce885
---
 drivers/misc/rk628/rk628.c | 43 ++++++++++++++++++++++++++++++++++++++
 drivers/misc/rk628/rk628.h |  1 +
 2 files changed, 44 insertions(+)

diff --git a/drivers/misc/rk628/rk628.c b/drivers/misc/rk628/rk628.c
index 8089b7d46d4800..60224bef77daec 100644
--- a/drivers/misc/rk628/rk628.c
+++ b/drivers/misc/rk628/rk628.c
@@ -13,6 +13,7 @@
 #include <linux/gpio/consumer.h>
 #include <linux/regmap.h>
 #include <linux/backlight.h>
+#include <linux/pm_runtime.h>
 
 #include "rk628.h"
 #include "rk628_cru.h"
@@ -280,6 +281,9 @@ static const struct regmap_config rk628_regmap_config[RK628_DEV_MAX] = {
 
 static void rk628_display_disable(struct rk628 *rk628)
 {
+	if (!rk628->display_enabled)
+		return;
+
 #ifdef RK628_CSI_OUT
 	rk628_csi_disable(rk628);
 #endif
@@ -299,10 +303,15 @@ static void rk628_display_disable(struct rk628 *rk628)
 #ifdef RK628_HDMI_IN
 	rk628_hdmirx_disable(rk628);
 #endif
+
+	rk628->display_enabled = false;
 }
 
 static void rk628_display_enable(struct rk628 *rk628)
 {
+	if (rk628->display_enabled)
+		return;
+
 #ifdef RK628_HDMI_IN
 	u8 ret = 0;
 
@@ -340,6 +349,7 @@ static void rk628_display_enable(struct rk628 *rk628)
 	rk628_hdmitx_enable(rk628);
 #endif
 
+	rk628->display_enabled = true;
 }
 
 static void rk628_display_work(struct work_struct *work)
@@ -560,14 +570,46 @@ rk628_i2c_probe(struct i2c_client *client, const struct i2c_device_id *id)
 	rk628_display_enable(rk628);
 #endif
 
+	pm_runtime_enable(dev);
+
 	return 0;
 }
 
 static int rk628_i2c_remove(struct i2c_client *client)
 {
+	struct device *dev = &client->dev;
+
+	pm_runtime_disable(dev);
+
 	return 0;
 }
 
+#ifdef CONFIG_PM_SLEEP
+static int rk628_suspend(struct device *dev)
+{
+	struct rk628 *rk628 = dev_get_drvdata(dev);
+
+	rk628_display_disable(rk628);
+
+	return 0;
+}
+
+static int rk628_resume(struct device *dev)
+{
+	struct rk628 *rk628 = dev_get_drvdata(dev);
+
+	rk628_display_enable(rk628);
+
+	return 0;
+}
+#endif
+
+static const struct dev_pm_ops rk628_pm_ops = {
+#ifdef CONFIG_PM_SLEEP
+	.suspend = rk628_suspend,
+	.resume = rk628_resume,
+#endif
+};
 static const struct of_device_id rk628_of_match[] = {
 	{ .compatible = "rockchip,rk628", },
 	{}
@@ -584,6 +626,7 @@ static struct i2c_driver rk628_i2c_driver = {
 	.driver = {
 		.name = "rk628",
 		.of_match_table = of_match_ptr(rk628_of_match),
+		.pm = &rk628_pm_ops,
 	},
 	.probe = rk628_i2c_probe,
 	.remove = rk628_i2c_remove,
diff --git a/drivers/misc/rk628/rk628.h b/drivers/misc/rk628/rk628.h
index c357313b8154eb..37997ea2d52153 100644
--- a/drivers/misc/rk628/rk628.h
+++ b/drivers/misc/rk628/rk628.h
@@ -273,6 +273,7 @@ struct rk628 {
 	struct delayed_work delay_work;
 	struct panel_simple *panel;
 	void *hdmirx;
+	bool display_enabled;
 };
 
 static inline int rk628_i2c_write(struct rk628 *rk628, u32 reg, u32 val)
-- 
2.17.1

