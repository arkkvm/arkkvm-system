From 46023736547e47dbb1a0da35e22a6017fae65b35 Mon Sep 17 00:00:00 2001
From: Shunqing Chen <csq@rock-chips.com>
Date: Tue, 17 Aug 2021 09:48:32 +0800
Subject: [PATCH 074/232] media: rk628-for-all: add direct mode support

Signed-off-by: Shunqing Chen <csq@rock-chips.com>
Change-Id: I7f8423288ceef19a8884db7a3a7e6cf0ce62cd64
Signed-off-by: Guochun Huang <hero.huang@rock-chips.com>
---
 drivers/media/i2c/rk628/rk628_bt1120_v4l2.c | 30 ++++++++++++---------
 drivers/media/i2c/rk628/rk628_csi.c         | 30 ++++++++++++---------
 drivers/media/i2c/rk628/rk628_csi_v4l2.c    | 30 ++++++++++++---------
 3 files changed, 54 insertions(+), 36 deletions(-)

diff --git a/drivers/media/i2c/rk628/rk628_bt1120_v4l2.c b/drivers/media/i2c/rk628/rk628_bt1120_v4l2.c
index fe4483aef63548..dd5035777d3511 100644
--- a/drivers/media/i2c/rk628/rk628_bt1120_v4l2.c
+++ b/drivers/media/i2c/rk628/rk628_bt1120_v4l2.c
@@ -244,6 +244,10 @@ static bool tx_5v_power_present(struct v4l2_subdev *sd)
 	int val, i, cnt;
 	struct rk628_bt1120 *bt1120 = to_bt1120(sd);
 
+	/* Direct Mode */
+	if (!bt1120->plugin_det_gpio)
+		return true;
+
 	cnt = 0;
 	for (i = 0; i < 5; i++) {
 		val = gpiod_get_value(bt1120->plugin_det_gpio);
@@ -2119,19 +2123,21 @@ static int rk628_bt1120_probe(struct i2c_client *client,
 		add_timer(&bt1120->timer);
 	}
 
-	bt1120->plugin_irq = gpiod_to_irq(bt1120->plugin_det_gpio);
-	if (bt1120->plugin_irq < 0) {
-		dev_err(bt1120->dev, "failed to get plugin det irq\n");
-		err = bt1120->plugin_irq;
-		goto err_work_queues;
-	}
+	if (bt1120->plugin_det_gpio) {
+		bt1120->plugin_irq = gpiod_to_irq(bt1120->plugin_det_gpio);
+		if (bt1120->plugin_irq < 0) {
+			dev_err(bt1120->dev, "failed to get plugin det irq\n");
+			err = bt1120->plugin_irq;
+			goto err_work_queues;
+		}
 
-	err = devm_request_threaded_irq(dev, bt1120->plugin_irq, NULL,
-			plugin_detect_irq, IRQF_TRIGGER_FALLING |
-			IRQF_TRIGGER_RISING | IRQF_ONESHOT, "rk628_bt1120", bt1120);
-	if (err) {
-		dev_err(bt1120->dev, "failed to register plugin det irq (%d)\n", err);
-		goto err_work_queues;
+		err = devm_request_threaded_irq(dev, bt1120->plugin_irq, NULL,
+				plugin_detect_irq, IRQF_TRIGGER_FALLING |
+				IRQF_TRIGGER_RISING | IRQF_ONESHOT, "rk628_bt1120", bt1120);
+		if (err) {
+			dev_err(bt1120->dev, "failed to register plugin det irq (%d)\n", err);
+			goto err_work_queues;
+		}
 	}
 
 	err = v4l2_ctrl_handler_setup(sd->ctrl_handler);
diff --git a/drivers/media/i2c/rk628/rk628_csi.c b/drivers/media/i2c/rk628/rk628_csi.c
index 705f0fb9f5defe..7cb60413095819 100644
--- a/drivers/media/i2c/rk628/rk628_csi.c
+++ b/drivers/media/i2c/rk628/rk628_csi.c
@@ -298,6 +298,10 @@ static bool tx_5v_power_present(struct rk628_csi *csi)
 	bool ret;
 	int val, i, cnt;
 
+	/* Direct Mode */
+	if (!csi->plugin_det_gpio)
+		return true;
+
 	cnt = 0;
 	for (i = 0; i < 5; i++) {
 		val = gpiod_get_value(csi->plugin_det_gpio);
@@ -1853,19 +1857,21 @@ static int rk628_csi_probe(struct i2c_client *client,
 		add_timer(&csi->timer);
 	}
 
-	csi->plugin_irq = gpiod_to_irq(csi->plugin_det_gpio);
-	if (csi->plugin_irq < 0) {
-		dev_err(csi->dev, "failed to get plugin det irq\n");
-		err = csi->plugin_irq;
-		goto err_work_queues;
-	}
+	if (csi->plugin_det_gpio) {
+		csi->plugin_irq = gpiod_to_irq(csi->plugin_det_gpio);
+		if (csi->plugin_irq < 0) {
+			dev_err(csi->dev, "failed to get plugin det irq\n");
+			err = csi->plugin_irq;
+			goto err_work_queues;
+		}
 
-	err = devm_request_threaded_irq(dev, csi->plugin_irq, NULL,
-			plugin_detect_irq, IRQF_TRIGGER_FALLING |
-			IRQF_TRIGGER_RISING | IRQF_ONESHOT, "rk628_csi", csi);
-	if (err) {
-		dev_err(csi->dev, "failed to register plugin det irq (%d)\n", err);
-		goto err_work_queues;
+		err = devm_request_threaded_irq(dev, csi->plugin_irq, NULL,
+				plugin_detect_irq, IRQF_TRIGGER_FALLING |
+				IRQF_TRIGGER_RISING | IRQF_ONESHOT, "rk628_csi", csi);
+		if (err) {
+			dev_err(csi->dev, "failed to register plugin det irq (%d)\n", err);
+			goto err_work_queues;
+		}
 	}
 
 	dev_info(csi->dev, "%s found @ 0x%x (%s)\n", client->name,
diff --git a/drivers/media/i2c/rk628/rk628_csi_v4l2.c b/drivers/media/i2c/rk628/rk628_csi_v4l2.c
index 38d6763b538aae..932ac100fd49b4 100644
--- a/drivers/media/i2c/rk628/rk628_csi_v4l2.c
+++ b/drivers/media/i2c/rk628/rk628_csi_v4l2.c
@@ -262,6 +262,10 @@ static bool tx_5v_power_present(struct v4l2_subdev *sd)
 	int val, i, cnt;
 	struct rk628_csi *csi = to_csi(sd);
 
+	/* Direct Mode */
+	if (!csi->plugin_det_gpio)
+		return true;
+
 	cnt = 0;
 	for (i = 0; i < 5; i++) {
 		val = gpiod_get_value(csi->plugin_det_gpio);
@@ -2487,19 +2491,21 @@ static int rk628_csi_probe(struct i2c_client *client,
 		add_timer(&csi->timer);
 	}
 
-	csi->plugin_irq = gpiod_to_irq(csi->plugin_det_gpio);
-	if (csi->plugin_irq < 0) {
-		dev_err(csi->dev, "failed to get plugin det irq\n");
-		err = csi->plugin_irq;
-		goto err_work_queues;
-	}
+	if (csi->plugin_det_gpio) {
+		csi->plugin_irq = gpiod_to_irq(csi->plugin_det_gpio);
+		if (csi->plugin_irq < 0) {
+			dev_err(csi->dev, "failed to get plugin det irq\n");
+			err = csi->plugin_irq;
+			goto err_work_queues;
+		}
 
-	err = devm_request_threaded_irq(dev, csi->plugin_irq, NULL,
-			plugin_detect_irq, IRQF_TRIGGER_FALLING |
-			IRQF_TRIGGER_RISING | IRQF_ONESHOT, "rk628_csi", csi);
-	if (err) {
-		dev_err(csi->dev, "failed to register plugin det irq (%d)\n", err);
-		goto err_work_queues;
+		err = devm_request_threaded_irq(dev, csi->plugin_irq, NULL,
+				plugin_detect_irq, IRQF_TRIGGER_FALLING |
+				IRQF_TRIGGER_RISING | IRQF_ONESHOT, "rk628_csi", csi);
+		if (err) {
+			dev_err(csi->dev, "failed to register plugin det irq (%d)\n", err);
+			goto err_work_queues;
+		}
 	}
 
 	err = v4l2_ctrl_handler_setup(sd->ctrl_handler);
