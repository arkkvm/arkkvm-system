new file mode 100644
index 00000000000000..dcd7ac5abc677c
--- /dev/null
+++ b/drivers/misc/rk628/rk628_efuse.h
@@ -0,0 +1,17 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
