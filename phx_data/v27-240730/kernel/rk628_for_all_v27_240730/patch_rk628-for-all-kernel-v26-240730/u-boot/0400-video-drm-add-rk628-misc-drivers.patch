+static int genif_wait_w_pld_fifo_not_full(struct rk628 *rk628,
+					  const struct rk628_dsi *dsi)
+{
+	u32 sts = 0;
+	int ret;
+	unsigned int dsi_base;
+
+	dsi_base = dsi->id ? DSI1_BASE : DSI0_BASE;
+
+	ret = rk628_read_poll_timeout(rk628, dsi_base + DSI_CMD_PKT_STATUS,
+				      sts, !(sts & GEN_PLD_W_FULL), 0, 1000);
+	if (ret < 0) {
+		printf("rk628 generic write payload fifo is full\n");
+		return ret;
+	}
+
+	return 0;
+}
+
+static int genif_wait_cmd_fifo_not_full(struct rk628 *rk628,
+					const struct rk628_dsi *dsi)
+{
+	u32 sts = 0;
+	int ret = 0;
+	unsigned int dsi_base;
+
+	dsi_base = dsi->id ? DSI1_BASE : DSI0_BASE;
+
+	ret = rk628_read_poll_timeout(rk628, dsi_base + DSI_CMD_PKT_STATUS,
+				      sts, !(sts & GEN_CMD_FULL),
+				       0, 1000);
+	if (ret < 0) {
+		printf("rk628 generic write cmd fifo is full\n");
+		return ret;
+	}
+
+	return 0;
+}
+
+static int genif_wait_write_fifo_empty(struct rk628 *rk628, const struct rk628_dsi *dsi)
+{
+	u32 sts = 0;
+	u32 mask;
+	int ret;
+	unsigned int dsi_base;
+
+	dsi_base = dsi->id ? DSI1_BASE : DSI0_BASE;
+
+	mask = GEN_CMD_EMPTY | GEN_PLD_W_EMPTY;
+
+	ret = rk628_read_poll_timeout(rk628, dsi_base + DSI_CMD_PKT_STATUS,
+				      sts, (sts & mask) == mask, 0, 1000);
+	if (ret < 0) {
+		printf("rk628 generic write fifo is full\n");
+		return ret;
+	}
+
+	return 0;
+}
+
+static int rk628_dsi_read_from_fifo(struct rk628 *rk628,
+				    const struct rk628_dsi *dsi,
+				    const struct rk628_mipi_dsi_msg *msg)
+{
+	u8 *payload = msg->rx_buf;
+	unsigned int vrefresh = 60;
+	u16 length;
+	u32 val = 0;
+	int ret;
+	unsigned int dsi_base;
+
+	dsi_base = dsi->id ? DSI1_BASE : DSI0_BASE;
+
+	ret = rk628_read_poll_timeout(rk628, dsi_base + DSI_CMD_PKT_STATUS,
+				      val, !(val & GEN_RD_CMD_BUSY),
+				      0, DIV_ROUND_UP(1000000, vrefresh));
+	if (ret) {
+		printf("rk628 entire response isn't stored in the FIFO\n");
+		return ret;
+	}
+
+	/* Receive payload */
+	for (length = msg->rx_len; length; length -= 4) {
+		dsi_read(rk628, dsi, DSI_CMD_PKT_STATUS, &val);
+		if (val & GEN_PLD_R_EMPTY)
+			ret = -ETIMEDOUT;
+		if (ret) {
+			printf("rk628 dsi Read payload FIFO is empty\n");
+			return ret;
+		}
+
+		dsi_read(rk628, dsi, DSI_GEN_PLD_DATA, &val);
+
+		switch (length) {
+		case 3:
+			payload[2] = (val >> 16) & 0xff;
+			/* Fall through */
+		case 2:
+			payload[1] = (val >> 8) & 0xff;
+			/* Fall through */
+		case 1:
+			payload[0] = val & 0xff;
+			return 0;
+		}
+
+		payload[0] = (val >>  0) & 0xff;
+		payload[1] = (val >>  8) & 0xff;
+		payload[2] = (val >> 16) & 0xff;
+		payload[3] = (val >> 24) & 0xff;
+		payload += 4;
+	}
+
+	return 0;
+}
+
+/**
+ * rk628_mipi_dsi_packet_format_is_short - check if a packet is of the short format
+ * @type: MIPI DSI data type of the packet
+ *
+ * Return: true if the packet for the given data type is a short packet, false
+ * otherwise.
+ */
+static bool rk628_mipi_dsi_packet_format_is_short(u8 type)
+{
+	switch (type) {
+	case RK628_MIPI_DSI_V_SYNC_START:
+	case RK628_MIPI_DSI_V_SYNC_END:
+	case RK628_MIPI_DSI_H_SYNC_START:
+	case RK628_MIPI_DSI_H_SYNC_END:
+	case RK628_MIPI_DSI_END_OF_TRANSMISSION:
+	case RK628_MIPI_DSI_COLOR_MODE_OFF:
+	case RK628_MIPI_DSI_COLOR_MODE_ON:
+	case RK628_MIPI_DSI_SHUTDOWN_PERIPHERAL:
+	case RK628_MIPI_DSI_TURN_ON_PERIPHERAL:
+	case RK628_MIPI_DSI_GENERIC_SHORT_WRITE_0_PARAM:
+	case RK628_MIPI_DSI_GENERIC_SHORT_WRITE_1_PARAM:
+	case RK628_MIPI_DSI_GENERIC_SHORT_WRITE_2_PARAM:
+	case RK628_MIPI_DSI_GENERIC_READ_REQUEST_0_PARAM:
+	case RK628_MIPI_DSI_GENERIC_READ_REQUEST_1_PARAM:
+	case RK628_MIPI_DSI_GENERIC_READ_REQUEST_2_PARAM:
+	case RK628_MIPI_DSI_DCS_SHORT_WRITE:
+	case RK628_MIPI_DSI_DCS_SHORT_WRITE_PARAM:
+	case RK628_MIPI_DSI_DCS_READ:
+	case RK628_MIPI_DSI_DCS_COMPRESSION_MODE:
+	case RK628_MIPI_DSI_SET_MAXIMUM_RETURN_PACKET_SIZE:
+		return true;
+	}
+
+	return false;
+}
+
+/**
+ * rk628_mipi_dsi_packet_format_is_long - check if a packet is of the long format
+ * @type: MIPI DSI data type of the packet
+ *
+ * Return: true if the packet for the given data type is a long packet, false
+ * otherwise.
+ */
+static bool rk628_mipi_dsi_packet_format_is_long(u8 type)
+{
+	switch (type) {
+	case RK628_MIPI_DSI_PPS_LONG_WRITE:
+	case RK628_MIPI_DSI_NULL_PACKET:
+	case RK628_MIPI_DSI_BLANKING_PACKET:
+	case RK628_MIPI_DSI_GENERIC_LONG_WRITE:
+	case RK628_MIPI_DSI_DCS_LONG_WRITE:
+	case RK628_MIPI_DSI_LOOSELY_PACKED_PIXEL_STREAM_YCBCR20:
+	case RK628_MIPI_DSI_PACKED_PIXEL_STREAM_YCBCR24:
+	case RK628_MIPI_DSI_PACKED_PIXEL_STREAM_YCBCR16:
+	case RK628_MIPI_DSI_PACKED_PIXEL_STREAM_30:
+	case RK628_MIPI_DSI_PACKED_PIXEL_STREAM_36:
+	case RK628_MIPI_DSI_PACKED_PIXEL_STREAM_YCBCR12:
+	case RK628_MIPI_DSI_PACKED_PIXEL_STREAM_16:
+	case RK628_MIPI_DSI_PACKED_PIXEL_STREAM_18:
+	case RK628_MIPI_DSI_PIXEL_STREAM_3BYTE_18:
+	case RK628_MIPI_DSI_PACKED_PIXEL_STREAM_24:
+		return true;
+	}
+
+	return false;
+}
+
+/**
+ * rk628_mipi_dsi_create_packet - create a packet from a message according to the
+ *     DSI protocol
+ * @packet: pointer to a DSI packet structure
+ * @msg: message to translate into a packet
+ *
+ * Return: 0 on success or a negative error code on failure.
+ */
+static int rk628_mipi_dsi_create_packet(struct rk628_mipi_dsi_packet *packet,
+			   const struct rk628_mipi_dsi_msg *msg)
+{
+	if (!packet || !msg)
+		return -EINVAL;
+
+	/* do some minimum sanity checking */
+	if (!rk628_mipi_dsi_packet_format_is_short(msg->type) &&
+	    !rk628_mipi_dsi_packet_format_is_long(msg->type))
+		return -EINVAL;
+
+	if (msg->channel > 3)
+		return -EINVAL;
+
+	memset(packet, 0, sizeof(*packet));
+	packet->header[0] = ((msg->channel & 0x3) << 6) | (msg->type & 0x3f);
+
+	/* TODO: compute ECC if hardware support is not available */
+
+	/*
+	 * Long write packets contain the word count in header bytes 1 and 2.
+	 * The payload follows the header and is word count bytes long.
+	 *
+	 * Short write packets encode up to two parameters in header bytes 1
+	 * and 2.
+	 */
+	if (rk628_mipi_dsi_packet_format_is_long(msg->type)) {
+		packet->header[1] = (msg->tx_len >> 0) & 0xff;
+		packet->header[2] = (msg->tx_len >> 8) & 0xff;
+
+		packet->payload_length = msg->tx_len;
+		packet->payload = msg->tx_buf;
+	} else {
+		const u8 *tx = msg->tx_buf;
+
+		packet->header[1] = (msg->tx_len > 0) ? tx[0] : 0;
+		packet->header[2] = (msg->tx_len > 1) ? tx[1] : 0;
+	}
+
+	packet->size = sizeof(packet->header) + packet->payload_length;
+
+	return 0;
+}
+
+static int rk628_dsi_transfer(struct rk628 *rk628, const struct rk628_dsi *dsi,
+			      const struct rk628_mipi_dsi_msg *msg)
+{
+	struct rk628_mipi_dsi_packet packet;
+	int ret;
+	u32 val;
+
+	if (msg->flags & RK628_MIPI_DSI_MSG_REQ_ACK)
+		dsi_update_bits(rk628, dsi, DSI_CMD_MODE_CFG,
+				ACK_RQST_EN, ACK_RQST_EN);
+
+	if (msg->flags & RK628_MIPI_DSI_MSG_USE_LPM) {
+		dsi_update_bits(rk628, dsi, DSI_VID_MODE_CFG,
+				LP_CMD_EN, LP_CMD_EN);
+	} else {
+		dsi_update_bits(rk628, dsi, DSI_VID_MODE_CFG, LP_CMD_EN, 0);
+		dsi_update_bits(rk628, dsi, DSI_LPCLK_CTRL,
+				PHY_TXREQUESTCLKHS, PHY_TXREQUESTCLKHS);
+	}
+
+	switch (msg->type) {
+	case RK628_MIPI_DSI_SHUTDOWN_PERIPHERAL:
+		//return rk628_dsi_shutdown_peripheral(dsi);
+	case RK628_MIPI_DSI_TURN_ON_PERIPHERAL:
+		//return rk628_dsi_turn_on_peripheral(dsi);
+	case RK628_MIPI_DSI_DCS_SHORT_WRITE:
+		dsi_update_bits(rk628, dsi, DSI_CMD_MODE_CFG, DCS_SW_0P_TX,
+				msg->flags & RK628_MIPI_DSI_MSG_USE_LPM ?
+				DCS_SW_0P_TX : 0);
+		break;
+	case RK628_MIPI_DSI_DCS_SHORT_WRITE_PARAM:
+		dsi_update_bits(rk628, dsi, DSI_CMD_MODE_CFG, DCS_SW_1P_TX,
+				msg->flags & RK628_MIPI_DSI_MSG_USE_LPM ?
+				DCS_SW_1P_TX : 0);
+		break;
+	case RK628_MIPI_DSI_DCS_LONG_WRITE:
+		dsi_update_bits(rk628, dsi, DSI_CMD_MODE_CFG, DCS_LW_TX,
+				msg->flags & RK628_MIPI_DSI_MSG_USE_LPM ?
+				DCS_LW_TX : 0);
+		break;
+	case RK628_MIPI_DSI_DCS_READ:
+		dsi_update_bits(rk628, dsi, DSI_CMD_MODE_CFG, DCS_SR_0P_TX,
+				msg->flags & RK628_MIPI_DSI_MSG_USE_LPM ?
+				DCS_SR_0P_TX : 0);
+		break;
+	case RK628_MIPI_DSI_SET_MAXIMUM_RETURN_PACKET_SIZE:
+		dsi_update_bits(rk628, dsi, DSI_CMD_MODE_CFG, MAX_RD_PKT_SIZE,
+				msg->flags & RK628_MIPI_DSI_MSG_USE_LPM ?
+				MAX_RD_PKT_SIZE : 0);
+		break;
+	case RK628_MIPI_DSI_GENERIC_SHORT_WRITE_0_PARAM:
+		dsi_update_bits(rk628, dsi, DSI_CMD_MODE_CFG, GEN_SW_0P_TX,
+				msg->flags & RK628_MIPI_DSI_MSG_USE_LPM ?
+				GEN_SW_0P_TX : 0);
+		break;
+	case RK628_MIPI_DSI_GENERIC_SHORT_WRITE_1_PARAM:
+		dsi_update_bits(rk628, dsi, DSI_CMD_MODE_CFG, GEN_SW_1P_TX,
+				msg->flags & RK628_MIPI_DSI_MSG_USE_LPM ?
+				GEN_SW_1P_TX : 0);
+		break;
+	case RK628_MIPI_DSI_GENERIC_SHORT_WRITE_2_PARAM:
+		dsi_update_bits(rk628, dsi, DSI_CMD_MODE_CFG, GEN_SW_2P_TX,
+				msg->flags & RK628_MIPI_DSI_MSG_USE_LPM ?
+				GEN_SW_2P_TX : 0);
+		break;
+	case RK628_MIPI_DSI_GENERIC_LONG_WRITE:
+		dsi_update_bits(rk628, dsi, DSI_CMD_MODE_CFG, GEN_LW_TX,
+				msg->flags & RK628_MIPI_DSI_MSG_USE_LPM ?
+				GEN_LW_TX : 0);
+		break;
+	case RK628_MIPI_DSI_GENERIC_READ_REQUEST_0_PARAM:
+		dsi_update_bits(rk628, dsi, DSI_CMD_MODE_CFG, GEN_SR_0P_TX,
+		msg->flags & RK628_MIPI_DSI_MSG_USE_LPM ? GEN_SR_0P_TX : 0);
+		break;
+	case RK628_MIPI_DSI_GENERIC_READ_REQUEST_1_PARAM:
+		dsi_update_bits(rk628, dsi, DSI_CMD_MODE_CFG, GEN_SR_1P_TX,
+		msg->flags & RK628_MIPI_DSI_MSG_USE_LPM ? GEN_SR_1P_TX : 0);
+		break;
+	case RK628_MIPI_DSI_GENERIC_READ_REQUEST_2_PARAM:
+		dsi_update_bits(rk628, dsi, DSI_CMD_MODE_CFG, GEN_SR_2P_TX,
+				msg->flags & RK628_MIPI_DSI_MSG_USE_LPM ? GEN_SR_2P_TX : 0);
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	/* create a packet to the DSI protocol */
+	ret = rk628_mipi_dsi_create_packet(&packet, msg);
+	if (ret) {
+		printf("rk628 dsi failed to create packet\n");
+		return ret;
+	}
+
+	/* Send payload */
+	while (packet.payload_length >= 4) {
+		/*
+		 * Alternatively, you can always keep the FIFO
+		 * nearly full by monitoring the FIFO state until
+		 * it is not full, and then writea single word of data.
+		 * This solution is more resource consuming
+		 * but it simultaneously avoids FIFO starvation,
+		 * making it possible to use FIFO sizes smaller than
+		 * the amount of data of the longest packet to be written.
+		 */
+		ret = genif_wait_w_pld_fifo_not_full(rk628, dsi);
+		if (ret)
+			return ret;
+
+		val = get_unaligned_le32(packet.payload);
+
+		dsi_write(rk628, dsi, DSI_GEN_PLD_DATA, val);
+
+
+		packet.payload += 4;
+		packet.payload_length -= 4;
+	}
+
+	val = 0;
+	switch (packet.payload_length) {
+	case 3:
+		val |= packet.payload[2] << 16;
+		/* Fall through */
+	case 2:
+		val |= packet.payload[1] << 8;
+		/* Fall through */
+	case 1:
+		val |= packet.payload[0];
+
+		dsi_write(rk628, dsi, DSI_GEN_PLD_DATA, val);
+		break;
+	}
+
+	ret = genif_wait_cmd_fifo_not_full(rk628, dsi);
+	if (ret)
+		return ret;
+
+	/* Send packet header */
+	val = get_unaligned_le32(packet.header);
+
+	dsi_write(rk628, dsi, DSI_GEN_HDR, val);
+
+	ret = genif_wait_write_fifo_empty(rk628, dsi);
+	if (ret)
+		return ret;
+
+	if (msg->rx_len) {
+		ret = rk628_dsi_read_from_fifo(rk628, dsi, msg);
+		if (ret < 0)
+			return ret;
+	}
+
+	if (dsi->slave) {
+		const struct rk628_dsi *dsi1 = &rk628->dsi1;
+
+		rk628_dsi_transfer(rk628, dsi1, msg);
+	}
+
+	return msg->tx_len;
+}
+
+static int rk628_mipi_dsi_generic_write(struct rk628 *rk628,
+					const void *payload, size_t size)
+{
+	const struct rk628_dsi *dsi = &rk628->dsi0;
+	struct rk628_mipi_dsi_msg msg;
+
+	memset(&msg, 0, sizeof(msg));
+	msg.channel = dsi->channel;
+	msg.tx_buf = payload;
+	msg.tx_len = size;
+	msg.rx_len = 0;
+
+	switch (size) {
+	case 0:
+		msg.type = RK628_MIPI_DSI_GENERIC_SHORT_WRITE_0_PARAM;
+		break;
+
+	case 1:
+		msg.type = RK628_MIPI_DSI_GENERIC_SHORT_WRITE_1_PARAM;
+		break;
+	case 2:
+		msg.type = RK628_MIPI_DSI_GENERIC_SHORT_WRITE_2_PARAM;
+		break;
+	default:
+		msg.type = RK628_MIPI_DSI_GENERIC_LONG_WRITE;
+		break;
+	}
+
+		if (dsi->mode_flags & RK628_MIPI_DSI_MODE_LPM)
+			msg.flags |= RK628_MIPI_DSI_MSG_USE_LPM;
+
+		return rk628_dsi_transfer(rk628, dsi, &msg);
+}
+
+static int rk628_mipi_dsi_dcs_write_buffer(struct rk628 *rk628,
+					   const void *data, size_t len)
+{
+	const struct rk628_dsi *dsi = &rk628->dsi0;
+	struct rk628_mipi_dsi_msg msg;
+
+	memset(&msg, 0, sizeof(msg));
+	msg.channel = dsi->channel;
+	msg.tx_buf = data;
+	msg.tx_len = len;
+	msg.rx_len = 0;
+
+	switch (len) {
+	case 0:
+		return -EINVAL;
+	case 1:
+		msg.type = RK628_MIPI_DSI_DCS_SHORT_WRITE;
+		break;
+	case 2:
+		msg.type = RK628_MIPI_DSI_DCS_SHORT_WRITE_PARAM;
+		break;
+	default:
+		msg.type = RK628_MIPI_DSI_DCS_LONG_WRITE;
+		break;
+	}
+
+	if (dsi->mode_flags & RK628_MIPI_DSI_MODE_LPM)
+		msg.flags |= RK628_MIPI_DSI_MSG_USE_LPM;
+
+	return rk628_dsi_transfer(rk628, dsi, &msg);
+}
+
+static __maybe_unused int rk628_mipi_dsi_dcs_read(struct rk628 *rk628, u8 cmd,
+						  void *data, size_t len)
+{
+	const struct rk628_dsi *dsi = &rk628->dsi0;
+	struct rk628_mipi_dsi_msg msg;
+
+	memset(&msg, 0, sizeof(msg));
+	msg.channel = dsi->channel;
+	msg.type = RK628_MIPI_DSI_DCS_READ;
+	msg.tx_buf = &cmd;
+	msg.tx_len = 1;
+	msg.rx_buf = data;
+	msg.rx_len = len;
+
+	return rk628_dsi_transfer(rk628, dsi, &msg);
+}
+
+static int
+panel_simple_xfer_dsi_cmd_seq(struct rk628 *rk628, struct panel_cmds *cmds)
+{
+	u16 i;
+	int err;
+
+	if (!cmds)
+		return 0;
+
+	for (i = 0; i < cmds->cmd_cnt; i++) {
+		struct cmd_desc *cmd = &cmds->cmds[i];
+
+		switch (cmd->dchdr.dtype) {
+		case RK628_MIPI_DSI_GENERIC_SHORT_WRITE_0_PARAM:
+		case RK628_MIPI_DSI_GENERIC_SHORT_WRITE_1_PARAM:
+		case RK628_MIPI_DSI_GENERIC_SHORT_WRITE_2_PARAM:
+		case RK628_MIPI_DSI_GENERIC_LONG_WRITE:
+			err = rk628_mipi_dsi_generic_write(rk628, cmd->payload,
+							   cmd->dchdr.dlen);
+			break;
+		case RK628_MIPI_DSI_DCS_SHORT_WRITE:
+		case RK628_MIPI_DSI_DCS_SHORT_WRITE_PARAM:
+		case RK628_MIPI_DSI_DCS_LONG_WRITE:
+			err = rk628_mipi_dsi_dcs_write_buffer(rk628, cmd->payload,
+							      cmd->dchdr.dlen);
+			break;
+		default:
+			printf("rk628 dsi panel cmd desc invalid data type\n");
+			return -EINVAL;
+		}
+
+		if (err < 0)
+			printf("rk628 dsi failed to write cmd\n");
+
+		if (cmd->dchdr.wait)
+			mdelay(cmd->dchdr.wait);
+	}
+
+	return 0;
+}
+
+static u32 rk628_dsi_get_lane_rate(const struct rk628_dsi *dsi)
+{
+	const struct drm_display_mode *mode = &dsi->rk628->dst_mode;
+	ofnode dsi_np;
+	u32 lane_rate, value;
+	u32 max_lane_rate = 1500;
+	u8 bpp, lanes;
+
+	dsi_np = dev_read_subnode(dsi->rk628->dev, "rk628-dsi-out");
+	if (!ofnode_valid(dsi_np))
+		dsi_np = dev_read_subnode(dsi->rk628->dev, "rk628-dsi");
+	if (ofnode_valid(dsi_np) && !ofnode_read_u32(dsi_np, "rockchip,lane-mbps", &value)) {
+		lane_rate = value;
+	} else {
+		bpp = dsi->bpp;
+		lanes = dsi->slave ? dsi->lanes * 2 : dsi->lanes;
+		lane_rate = mode->clock / 1000 * bpp / lanes;
+		lane_rate = DIV_ROUND_UP(lane_rate * 5, 4);
+	}
+
+	if (lane_rate > max_lane_rate)
+		lane_rate = max_lane_rate;
+
+	return lane_rate;
+}
