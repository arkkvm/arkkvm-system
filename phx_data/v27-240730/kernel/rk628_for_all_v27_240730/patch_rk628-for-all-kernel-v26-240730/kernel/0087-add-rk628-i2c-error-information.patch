From 74d73f29ba36caf63a8c88fbe573c76d81b8419f Mon Sep 17 00:00:00 2001
From: Luo Wei <lw@rock-chips.com>
Date: Wed, 1 Sep 2021 15:31:44 +0800
Subject: [PATCH 087/232] add rk628 i2c error information

Signed-off-by: Luo Wei <lw@rock-chips.com>
Change-Id: I7545c15e58ee636e5e233513be8baa57de697478
Signed-off-by: Guochun Huang <hero.huang@rock-chips.com>
---
 drivers/media/i2c/rk628/rk628.h | 14 ++++++++++++--
 drivers/misc/rk628/rk628.h      | 14 ++++++++++++--
 2 files changed, 24 insertions(+), 4 deletions(-)
 mode change 100644 => 100755 drivers/media/i2c/rk628/rk628.h

diff --git a/drivers/media/i2c/rk628/rk628.h b/drivers/media/i2c/rk628/rk628.h
old mode 100644
new mode 100755
index f1c5fd595319c5..9088af9eedb944
--- a/drivers/media/i2c/rk628/rk628.h
+++ b/drivers/media/i2c/rk628/rk628.h
@@ -258,15 +258,25 @@ int rk628_i2c_update_bits(struct rk628 *rk628, u32 reg, u32 mask,
 static inline int rk628_i2c_write(struct rk628 *rk628, u32 reg, u32 val)
 {
 	int region = (reg >> 16) & 0xff;
+	int ret = 0;
 
-	return regmap_write(rk628->regmap[region], reg, val);
+	ret = regmap_write(rk628->regmap[region], reg, val);
+	if(ret < 0)
+		pr_info("%s: i2c err reg=0x%x, val=0x%x, ret=%d\n", __func__, reg, val, ret);
+
+	return ret;
 }
 
 static inline int rk628_i2c_read(struct rk628 *rk628, u32 reg, u32 *val)
 {
 	int region = (reg >> 16) & 0xff;
+	int ret = 0;
+
+	ret = regmap_read(rk628->regmap[region], reg, val);
+	if(ret < 0)
+		pr_info("%s: i2c err reg=0x%x, val=0x%x ret=%d\n", __func__, reg, *val, ret);
 
-	return regmap_read(rk628->regmap[region], reg, val);
+	return ret;
 }
 
 static inline int rk628_i2c_update_bits(struct rk628 *rk628, u32 reg, u32 mask,
diff --git a/drivers/misc/rk628/rk628.h b/drivers/misc/rk628/rk628.h
index ecceb761e5a1f3..8109cb499fe82f 100755
--- a/drivers/misc/rk628/rk628.h
+++ b/drivers/misc/rk628/rk628.h
@@ -267,15 +267,25 @@ struct rk628 {
 static inline int rk628_i2c_write(struct rk628 *rk628, u32 reg, u32 val)
 {
 	int region = (reg >> 16) & 0xff;
+	int ret = 0;
 
-	return regmap_write(rk628->regmap[region], reg, val);
+	ret = regmap_write(rk628->regmap[region], reg, val);
+	if(ret < 0)
+		pr_info("%s: i2c err reg=0x%x, val=0x%x, ret=%d\n", __func__, reg, val, ret);
+
+	return ret;
 }
 
 static inline int rk628_i2c_read(struct rk628 *rk628, u32 reg, u32 *val)
 {
 	int region = (reg >> 16) & 0xff;
+	int ret = 0;
+
+	ret = regmap_read(rk628->regmap[region], reg, val);
+	if(ret < 0)
+		pr_info("%s: i2c err reg=0x%x, val=0x%x ret=%d\n", __func__, reg, *val, ret);
 
-	return regmap_read(rk628->regmap[region], reg, val);
+	return ret;
 }
 
 static inline int rk628_i2c_update_bits(struct rk628 *rk628, u32 reg, u32 mask,
-- 
