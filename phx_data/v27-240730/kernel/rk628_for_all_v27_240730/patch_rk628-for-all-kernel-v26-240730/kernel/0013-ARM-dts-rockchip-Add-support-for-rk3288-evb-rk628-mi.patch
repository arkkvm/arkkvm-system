From 3ca211b5970bff13b9688f395ee79f53277bccac Mon Sep 17 00:00:00 2001
From: Guochun Huang <hero.huang@rock-chips.com>
Date: Fri, 4 Jun 2021 15:18:34 +0800
Subject: [PATCH 013/232] ARM: dts: rockchip: Add support for
 rk3288-evb-rk628-misc-rgb2dsi/lvds

Signed-off-by: Guochun Huang <hero.huang@rock-chips.com>
Change-Id: Iec278f7e4d96511395204e8d446dbf130fbe24db
---
 .../dts/rk3288-evb-rk628-misc-rgb2dsi-avb.dts | 114 ++++++++++++++++
 .../rk3288-evb-rk628-misc-rgb2lvds-avb.dts    | 126 ++++++++++++++++++
 2 files changed, 240 insertions(+)
 create mode 100644 arch/arm/boot/dts/rk3288-evb-rk628-misc-rgb2dsi-avb.dts
 create mode 100644 arch/arm/boot/dts/rk3288-evb-rk628-misc-rgb2lvds-avb.dts

diff --git a/arch/arm/boot/dts/rk3288-evb-rk628-misc-rgb2dsi-avb.dts b/arch/arm/boot/dts/rk3288-evb-rk628-misc-rgb2dsi-avb.dts
new file mode 100644
index 00000000000000..0b843e1e793505
--- /dev/null
+++ b/arch/arm/boot/dts/rk3288-evb-rk628-misc-rgb2dsi-avb.dts
@@ -0,0 +1,114 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+// Copyright (c) 2020 Fuzhou Rockchip Electronics Co., Ltd
+
+/dts-v1/;
+#include "rk3288-evb-rk628.dtsi"
+
+/ {
+	model = "Rockchip RK3288 EVB RK628 Board";
+	compatible = "rockchip,rk3288-evb-rk628", "rockchip,rk3288";
+
+	chosen {
+		bootargs = "rootwait earlycon=uart8250,mmio32,0xff690000 vmalloc=496M swiotlb=1 console=ttyFIQ0 androidboot.baseband=N/A androidboot.veritymode=enforcing androidboot.hardware=rk30board androidboot.console=ttyFIQ0 init=/init kpti=0";
+	};
+	panel {
+		compatible = "simple-panel";
+		backlight = <&backlight>;
+		//enable-gpios = <&gpio7 RK_PA2 GPIO_ACTIVE_HIGH>;
+		prepare-delay-ms = <120>;
+		enable-delay-ms = <120>;
+		disable-delay-ms = <120>;
+		unprepare-delay-ms = <20>;
+		status = "okay";
+
+		display-timings {
+			native-mode = <&timing0>;
+
+			timing0: timing0 {
+				clock-frequency = <132000000>;
+				hactive = <1080>;
+				vactive = <1920>;
+				hback-porch = <30>;
+				hfront-porch = <15>;
+				vback-porch = <15>;
+				vfront-porch = <15>;
+				hsync-len = <2>;
+				vsync-len = <2>;
+				hsync-active = <1>;
+				vsync-active = <1>;
+				de-active = <0>;
+				pixelclk-active = <0>;
+			};
+		};
+
+		port {
+			panel_in_lvds: endpoint {
+				remote-endpoint = <&lvds_out_panel>;
+			};
+		};
+	};
+
+};
+
+&firmware_android {
+	compatible = "android,firmware";
+	boot_devices = "ff0f0000.dwmmc";
+
+	vbmeta {
+		compatible = "android,vbmeta";
+		parts = "vbmeta,boot,system,vendor,dtbo";
+	};
+
+	fstab {
+		compatible = "android,fstab";
+
+		vendor {
+			compatible = "android,vendor";
+			dev = "/dev/block/by-name/vendor";
+			type = "ext4";
+			mnt_flags = "ro,barrier=1,inode_readahead_blks=8";
+			fsmgr_flags = "wait,avb";
+		};
+	};
+};
+
+&rgb {
+	status = "okay";
+
+	ports {
+		port@1 {
+			reg = <1>;
+
+			lvds_out_panel: endpoint {
+				remote-endpoint = <&panel_in_lvds>;
+			};
+		};
+	};
+};
+
+&rk628 {
+	reg = <0x50>;
+	interrupt-parent = <&gpio7>;
+	interrupts = <15 IRQ_TYPE_LEVEL_HIGH>;
+	enable-gpios = <&gpio5 RK_PC2 GPIO_ACTIVE_HIGH>;
+	reset-gpios = <&gpio7 RK_PB6 GPIO_ACTIVE_LOW>;
+	panel-enable-gpios = <&gpio7 RK_PA2 GPIO_ACTIVE_HIGH>;
+	status = "okay";
+};
+
+&video_phy {
+	status = "okay";
+};
+
+&rgb_in_vopb {
+	status = "disabled";
+};
+
+&rgb_in_vopl {
+	status = "okay";
+};
+
+&route_rgb {
+	connect = <&vopl_out_rgb>;
+	status = "okay";
+};
diff --git a/arch/arm/boot/dts/rk3288-evb-rk628-misc-rgb2lvds-avb.dts b/arch/arm/boot/dts/rk3288-evb-rk628-misc-rgb2lvds-avb.dts
new file mode 100644
index 00000000000000..6463ab836767bf
--- /dev/null
+++ b/arch/arm/boot/dts/rk3288-evb-rk628-misc-rgb2lvds-avb.dts
@@ -0,0 +1,126 @@
