#!/bin/sh
# staging udhcpc script: configure interface address only; no default route or resolv.conf changes
# For VLAN pending window; keep parent management path

[ -z "$interface" ] && exit 0

case "$1" in
bound | renew)
	[ -n "$ip" ] || exit 0
	if [ -n "$subnet" ]; then
		case "$subnet" in
		*.*)
			prefix=$(echo "$subnet" | awk -F. '{
				n=0
				for (i=1;i<=4;i++) {
					d=$i+0
					if (d==255) n+=8
					else if (d==254) n+=7
					else if (d==252) n+=6
					else if (d==248) n+=5
					else if (d==240) n+=4
					else if (d==224) n+=3
					else if (d==192) n+=2
					else if (d==128) n+=1
					else if (d==0) { print n; exit }
					else { print 24; exit }
				}
				print n
			}')
			;;
		*) prefix="$subnet" ;;
		esac
	else
		prefix=24
	fi
	ip addr flush dev "$interface" 2>/dev/null || true
	ip addr add "${ip}/${prefix}" dev "$interface" 2>/dev/null || true
	;;
deconfig)
	ip addr flush dev "$interface" 2>/dev/null || true
	;;
esac

exit 0
