+static void rk628_bt1120_set_hdmi_hdcp(struct v4l2_subdev *sd, bool en)
+{
+	u16 i;
+
+	v4l2_dbg(1, debug, sd, "%s: %sable\n", __func__, en ? "en" : "dis");
+
+	if (en) {
+		rk628_i2c_update_bits(HDMI_RX_HDCP_CTRL,
+				HDCP_ENABLE_MASK |
+				HDCP_ENC_EN_MASK,
+				HDCP_ENABLE(1) |
+				HDCP_ENC_EN(1));
+		rk628_i2c_update_bits(GRF_SYSTEM_CON0,
+				SW_ADAPTER_I2CSLADR_MASK |
+				SW_EFUSE_HDCP_EN_MASK,
+				SW_ADAPTER_I2CSLADR(0) |
+				SW_EFUSE_HDCP_EN(1));
+		for ( i = 0; i < ARRAY_SIZE(hdcp_key_data); i++) {
+			rk628_i2c_write(HDCP_KEY_BASE + i * 4, hdcp_key_data[i]);
+		}
+
+		rk628_i2c_update_bits(GRF_SYSTEM_CON0,
+				SW_ADAPTER_I2CSLADR_MASK |
+				SW_EFUSE_HDCP_EN_MASK,
+				SW_ADAPTER_I2CSLADR(0) |
+				SW_EFUSE_HDCP_EN(0));
+		rk628_i2c_update_bits(HDMI_RX_HDCP_CTRL,
+				HDCP_ENABLE_MASK |
+				HDCP_ENC_EN_MASK,
+				HDCP_ENABLE(1) |
+				HDCP_ENC_EN(1));
+	} else {
+		rk628_i2c_update_bits(HDMI_RX_HDCP_CTRL,
+				HDCP_ENABLE_MASK |
+				HDCP_ENC_EN_MASK,
+				HDCP_ENABLE(0) |
+				HDCP_ENC_EN(0));
+	}
+}
