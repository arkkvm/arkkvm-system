From 121ad6c5e749e1194ad82b052e8572b5d2fc8a0d Mon Sep 17 00:00:00 2001
From: Shunqing Chen <csq@rock-chips.com>
Date: Wed, 4 Aug 2021 14:33:39 +0800
Subject: [PATCH 050/232] media: rk628-for-all: audio and video output at the
 same time

Signed-off-by: Shunqing Chen <csq@rock-chips.com>
Change-Id: I9e076d47e0e16a9b10ff3e0b8b2206f29f8b3168
Signed-off-by: Guochun Huang <hero.huang@rock-chips.com>
---
 drivers/media/i2c/rk628/rk628_bt1120_v4l2.c | 11 ++++++++++-
 drivers/media/i2c/rk628/rk628_csi.c         | 11 ++++++++++-
 drivers/media/i2c/rk628/rk628_csi_v4l2.c    | 11 ++++++++++-
 drivers/media/i2c/rk628/rk628_hdmirx.h      |  2 ++
 4 files changed, 32 insertions(+), 3 deletions(-)

diff --git a/drivers/media/i2c/rk628/rk628_bt1120_v4l2.c b/drivers/media/i2c/rk628/rk628_bt1120_v4l2.c
index 85e3418b26958f..31031d4380562e 100644
--- a/drivers/media/i2c/rk628/rk628_bt1120_v4l2.c
+++ b/drivers/media/i2c/rk628/rk628_bt1120_v4l2.c
@@ -875,9 +875,17 @@ static void rk628_hdmirx_vid_enable(struct v4l2_subdev *sd, bool en)
 
 	v4l2_dbg(1, debug, sd, "%s: %sable\n", __func__, en ? "en" : "dis");
 	if (en) {
+		rk628_i2c_write(bt1120->rk628, HDMI_RX_AUD_SAO_CTRL,
+				I2S_LPCM_BPCUV(0) |
+				I2S_32_16(1)|
+				I2S_ENABLE_BITS(0));
 		rk628_i2c_update_bits(bt1120->rk628, HDMI_RX_DMI_DISABLE_IF,
 				VID_ENABLE_MASK, VID_ENABLE(1));
 	} else {
+		rk628_i2c_write(bt1120->rk628, HDMI_RX_AUD_SAO_CTRL,
+				I2S_LPCM_BPCUV(0) |
+				I2S_32_16(1)|
+				I2S_ENABLE_BITS(0x3f));
 		rk628_i2c_update_bits(bt1120->rk628, HDMI_RX_DMI_DISABLE_IF,
 				VID_ENABLE_MASK, VID_ENABLE(0));
 	}
@@ -934,7 +942,8 @@ static void rk628_hdmirx_audio_setup(struct v4l2_subdev *sd)
 			AFIF_SUBPACKETS(1));
 	rk628_i2c_write(bt1120->rk628, HDMI_RX_AUD_SAO_CTRL,
 			I2S_LPCM_BPCUV(0) |
-			I2S_32_16(1));
+			I2S_32_16(1) |
+			I2S_ENABLE_BITS(0x3f));
 	rk628_i2c_write(bt1120->rk628, HDMI_RX_AUD_MUTE_CTRL,
 			APPLY_INT_MUTE(0)	|
 			APORT_SHDW_CTRL(3)	|
diff --git a/drivers/media/i2c/rk628/rk628_csi.c b/drivers/media/i2c/rk628/rk628_csi.c
index 2cd767fb9e9bad..7f10a366eb575a 100644
--- a/drivers/media/i2c/rk628/rk628_csi.c
+++ b/drivers/media/i2c/rk628/rk628_csi.c
@@ -964,9 +964,17 @@ static void rk628_hdmirx_vid_enable(struct rk628_csi *csi, bool en)
 {
 	dev_dbg(csi->dev, "%s: %sable\n", __func__, en ? "en" : "dis");
 	if (en) {
+		rk628_i2c_write(csi->rk628, HDMI_RX_AUD_SAO_CTRL,
+				I2S_LPCM_BPCUV(0) |
+				I2S_32_16(1)|
+				I2S_ENABLE_BITS(0));
 		rk628_i2c_update_bits(csi->rk628, HDMI_RX_DMI_DISABLE_IF,
 				VID_ENABLE_MASK, VID_ENABLE(1));
 	} else {
+		rk628_i2c_write(csi->rk628, HDMI_RX_AUD_SAO_CTRL,
+				I2S_LPCM_BPCUV(0) |
+				I2S_32_16(1)|
+				I2S_ENABLE_BITS(0x3f));
 		rk628_i2c_update_bits(csi->rk628, HDMI_RX_DMI_DISABLE_IF,
 				VID_ENABLE_MASK, VID_ENABLE(0));
 	}
@@ -1020,7 +1028,8 @@ static void rk628_hdmirx_audio_setup(struct rk628_csi *csi)
 			AFIF_SUBPACKETS(1));
 	rk628_i2c_write(csi->rk628, HDMI_RX_AUD_SAO_CTRL,
 			I2S_LPCM_BPCUV(0) |
-			I2S_32_16(1));
+			I2S_32_16(1) |
+			I2S_ENABLE_BITS(0x3f));
 	rk628_i2c_write(csi->rk628, HDMI_RX_AUD_MUTE_CTRL,
 			APPLY_INT_MUTE(0)	|
 			APORT_SHDW_CTRL(3)	|
diff --git a/drivers/media/i2c/rk628/rk628_csi_v4l2.c b/drivers/media/i2c/rk628/rk628_csi_v4l2.c
index 589ba211654537..adb7c09e02bd2a 100644
--- a/drivers/media/i2c/rk628/rk628_csi_v4l2.c
+++ b/drivers/media/i2c/rk628/rk628_csi_v4l2.c
@@ -1050,9 +1050,17 @@ static void rk628_hdmirx_vid_enable(struct v4l2_subdev *sd, bool en)
 
 	v4l2_dbg(1, debug, sd, "%s: %sable\n", __func__, en ? "en" : "dis");
 	if (en) {
+		rk628_i2c_write(csi->rk628, HDMI_RX_AUD_SAO_CTRL,
+				I2S_LPCM_BPCUV(0) |
+				I2S_32_16(1)|
+				I2S_ENABLE_BITS(0));
 		rk628_i2c_update_bits(csi->rk628, HDMI_RX_DMI_DISABLE_IF,
 				VID_ENABLE_MASK, VID_ENABLE(1));
 	} else {
+		rk628_i2c_write(csi->rk628, HDMI_RX_AUD_SAO_CTRL,
+				I2S_LPCM_BPCUV(0) |
+				I2S_32_16(1)|
+				I2S_ENABLE_BITS(0x3f));
 		rk628_i2c_update_bits(csi->rk628, HDMI_RX_DMI_DISABLE_IF,
 				VID_ENABLE_MASK, VID_ENABLE(0));
 	}
@@ -1207,7 +1215,8 @@ static void rk628_hdmirx_audio_setup(struct v4l2_subdev *sd)
 			AFIF_SUBPACKETS(1));
 	rk628_i2c_write(csi->rk628, HDMI_RX_AUD_SAO_CTRL,
 			I2S_LPCM_BPCUV(0) |
-			I2S_32_16(1));
+			I2S_32_16(1) |
+			I2S_ENABLE_BITS(0x3f));
 	rk628_i2c_write(csi->rk628, HDMI_RX_AUD_MUTE_CTRL,
 			APPLY_INT_MUTE(0)	|
 			APORT_SHDW_CTRL(3)	|
diff --git a/drivers/media/i2c/rk628/rk628_hdmirx.h b/drivers/media/i2c/rk628/rk628_hdmirx.h
index fa69812537ad47..498ce6aff493ae 100644
--- a/drivers/media/i2c/rk628/rk628_hdmirx.h
+++ b/drivers/media/i2c/rk628/rk628_hdmirx.h
@@ -173,6 +173,8 @@
 #define AUD_MUTE_MODE(x)  		UPDATE(x, 4, 3)
 #define HDMI_RX_AUD_FIFO_FILLSTS1	(HDMI_RX_BASE + 0x025c)
 #define HDMI_RX_AUD_SAO_CTRL		(HDMI_RX_BASE + 0x0260)
+#define I2S_ENABLE_BITS_MASK		GENMASK(10, 5)
+#define I2S_ENABLE_BITS(x)		UPDATE(x, 10, 5)
 #define I2S_LPCM_BPCUV_MASK		BIT(11)
 #define I2S_LPCM_BPCUV(x)		UPDATE(x, 11, 11)
 #define I2S_32_16_MASK			BIT(0)
-- 
2.17.1

