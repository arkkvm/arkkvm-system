+
+int rk628_dsi_parse(struct rk628 *rk628, ofnode dsi_np)
+{
+	const char *string;
+	int ret;
+
+	if (!ofnode_valid(dsi_np))
+		return -EINVAL;
+
+	rk628->dsi0.id = 0;
+	rk628->dsi0.channel = 0;
+	rk628->dsi0.rk628 = rk628;
+
+	rk628->dsi0.lanes = ofnode_read_u32_default(dsi_np, "dsi,lanes", 4);
+	if (ofnode_read_bool(dsi_np, "dsi,video-mode"))
+		rk628->dsi0.mode_flags |= RK628_MIPI_DSI_MODE_LPM | RK628_MIPI_DSI_MODE_VIDEO |
+					  RK628_MIPI_DSI_MODE_VIDEO_BURST;
+	else
+		rk628->dsi0.mode_flags |= RK628_MIPI_DSI_MODE_LPM;
+
+	if (ofnode_read_bool(dsi_np, "dsi,eotp"))
+		rk628->dsi0.mode_flags |= RK628_MIPI_DSI_MODE_EOT_PACKET;
+
+	if (ofnode_read_bool(dsi_np, "dsi,clk-non-continuous"))
+		rk628->dsi0.mode_flags |= RK628_MIPI_DSI_CLOCK_NON_CONTINUOUS;
+
+	string = ofnode_read_string(dsi_np, "dsi,format");
+	if (!strcmp(string, "rgb666")) {
+		rk628->dsi0.bus_format = RK628_MIPI_DSI_FMT_RGB666;
+		rk628->dsi0.bpp = 24;
+	} else if (!strcmp(string, "rgb666-packed")) {
+		rk628->dsi0.bus_format = RK628_MIPI_DSI_FMT_RGB666_PACKED;
+		rk628->dsi0.bpp = 18;
+	} else if (!strcmp(string, "rgb565")) {
+		rk628->dsi0.bus_format = RK628_MIPI_DSI_FMT_RGB565;
+		rk628->dsi0.bpp = 16;
+	} else {
+		rk628->dsi0.bus_format = RK628_MIPI_DSI_FMT_RGB888;
+		rk628->dsi0.bpp = 24;
+	}
+
+	if (ofnode_read_bool(dsi_np, "rockchip,dual-channel")) {
+		rk628->dsi0.master = false;
+		rk628->dsi0.slave = true;
+
+		memcpy(&rk628->dsi1, &rk628->dsi0, sizeof(struct rk628_dsi));
+		rk628->dsi1.id = 1;
+		rk628->dsi1.master = true;
+		rk628->dsi1.slave = false;
+	}
+
+	ret = rk628_panel_info_get(rk628, dsi_np);
+	if (ret)
+		return ret;
+
+
+	return 0;
+}
