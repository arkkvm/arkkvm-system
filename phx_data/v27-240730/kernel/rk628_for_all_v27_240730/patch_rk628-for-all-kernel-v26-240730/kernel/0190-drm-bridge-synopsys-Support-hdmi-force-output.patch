From 4b271b5307e4a6da03fd2bff8835fca73846f312 Mon Sep 17 00:00:00 2001
From: Algea Cao <algea.cao@rock-chips.com>
Date: Fri, 17 Nov 2023 09:55:52 +0800
Subject: [PATCH 190/232] drm/bridge: synopsys: Support hdmi force output

Support hdmi output specific resolution and color format
regardless of whether hdmi is connected.

Signed-off-by: Algea Cao <algea.cao@rock-chips.com>
Change-Id: I228a74d128aa818166f589798897729473d97610
Signed-off-by: Guochun Huang <hero.huang@rock-chips.com>
---
 drivers/gpu/drm/bridge/synopsys/dw-hdmi.c   |  53 +++++++--
 drivers/gpu/drm/rockchip/dw_hdmi-rockchip.c | 117 ++++++++++++++------
 include/drm/bridge/dw_hdmi.h                |   2 +
 3 files changed, 127 insertions(+), 45 deletions(-)

diff --git a/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c b/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c
index 40b566e5f2e91c..aba6f7eee80442 100644
--- a/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c
+++ b/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c
@@ -253,7 +253,8 @@ struct dw_hdmi {
 	bool sink_is_hdmi;
 	bool sink_has_audio;
 	bool hpd_state;
-	bool force_logo;
+	bool force_logo;		/* force uboot hdmi output specific resolution */
+	bool force_kernel_output;	/* force kernel hdmi output specific resolution */
 
 	struct delayed_work work;
 	struct workqueue_struct *workqueue;
@@ -1630,17 +1631,14 @@ static int hdmi_phy_configure(struct dw_hdmi *hdmi)
 static int dw_hdmi_phy_init(struct dw_hdmi *hdmi, void *data,
 			    struct drm_display_mode *mode)
 {
-	int i, ret;
+	int ret;
 
-	/* HDMI Phy spec says to do the phy initialization sequence twice */
-	for (i = 0; i < 2; i++) {
-		dw_hdmi_phy_sel_data_en_pol(hdmi, 1);
-		dw_hdmi_phy_sel_interface_control(hdmi, 0);
+	dw_hdmi_phy_sel_data_en_pol(hdmi, 1);
+	dw_hdmi_phy_sel_interface_control(hdmi, 0);
 
-		ret = hdmi_phy_configure(hdmi);
-		if (ret)
-			return ret;
-	}
+	ret = hdmi_phy_configure(hdmi);
+	if (ret)
+		return ret;
 
 	return 0;
 }
@@ -2487,7 +2485,7 @@ static void dw_hdmi_update_power(struct dw_hdmi *hdmi)
 	}
 
 	if (force == DRM_FORCE_OFF) {
-		if (hdmi->initialized) {
+		if (hdmi->initialized && !hdmi->force_kernel_output) {
 			hdmi->initialized = false;
 			hdmi->disabled = true;
 		}
@@ -2600,6 +2598,9 @@ dw_hdmi_connector_detect(struct drm_connector *connector, bool force)
 	dw_hdmi_update_phy_mask(hdmi);
 	mutex_unlock(&hdmi->mutex);
 
+	if (hdmi->force_kernel_output)
+		return connector_status_connected;
+
 	connect_status = hdmi->phy.ops->read_hpd(hdmi, hdmi->phy.data);
 
 #ifdef CONFIG_SWITCH
@@ -2627,6 +2628,21 @@ static int dw_hdmi_connector_get_modes(struct drm_connector *connector)
 	if (!hdmi->ddc)
 		return 0;
 
+	if (hdmi->force_kernel_output) {
+		mode = hdmi->plat_data->get_force_timing(hdmi->plat_data->phy_data);
+		hdmi->sink_is_hdmi = true;
+		hdmi->sink_has_audio = true;
+		hdmi->connector.display_info.hdmi.scdc.supported = true;
+		mode = drm_mode_duplicate(connector->dev, mode);
+		drm_mode_debug_printmodeline(mode);
+		drm_mode_probed_add(connector, mode);
+		info->edid_hdmi_dc_modes = 0;
+		info->hdmi.y420_dc_modes = 0;
+		info->color_formats = 0;
+
+		return 1;
+	}
+
 	edid = drm_get_edid(connector, hdmi->ddc);
 	if (edid) {
 		dev_dbg(hdmi->dev, "got edid: width[%d] x height[%d]\n",
@@ -2676,6 +2692,9 @@ dw_hdmi_connector_mode_valid(struct drm_connector *connector,
 					   struct dw_hdmi, connector);
 	enum drm_mode_status mode_status = MODE_OK;
 
+	if (hdmi->force_kernel_output)
+		return MODE_OK;
+
 	if (hdmi->plat_data->mode_valid)
 		mode_status = hdmi->plat_data->mode_valid(connector, mode);
 
@@ -2995,7 +3014,8 @@ static irqreturn_t dw_hdmi_irq(int irq, void *dev_id)
 	if (intr_stat &
 	    (HDMI_IH_PHY_STAT0_RX_SENSE | HDMI_IH_PHY_STAT0_HPD)) {
 		mutex_lock(&hdmi->mutex);
-		if (!hdmi->bridge_is_on && !hdmi->force && !hdmi->force_logo) {
+		if (!hdmi->bridge_is_on && !hdmi->force && !hdmi->force_logo &&
+			!hdmi->force_kernel_output) {
 			/*
 			 * If the RX sense status indicates we're disconnected,
 			 * clear the software rxsense status.
@@ -3660,6 +3680,12 @@ static int get_force_logo_property(struct dw_hdmi *hdmi)
 	}
 	of_node_put(route);
 
+	if (!of_device_is_available(route_hdmi)) {
+		dev_dbg(hdmi->dev, "route-hdmi is disabled\n");
+		of_node_put(route_hdmi);
+		return 0;
+	}
+
 	hdmi->force_logo =
 		of_property_read_bool(route_hdmi, "force-output");
 
@@ -3833,6 +3859,9 @@ int dw_hdmi_bind(struct device *dev, struct device *master,
 	if (ret)
 		goto err_iahb;
 
+	if (hdmi->plat_data->get_force_timing(hdmi->plat_data->phy_data))
+		hdmi->force_kernel_output = true;
+
 	hdmi->initialized = false;
 	ret = hdmi_readb(hdmi, HDMI_PHY_STAT0);
 
diff --git a/drivers/gpu/drm/rockchip/dw_hdmi-rockchip.c b/drivers/gpu/drm/rockchip/dw_hdmi-rockchip.c
index 3c98573ca01b59..0ba2d16c1a34b9 100644
--- a/drivers/gpu/drm/rockchip/dw_hdmi-rockchip.c
+++ b/drivers/gpu/drm/rockchip/dw_hdmi-rockchip.c
@@ -25,6 +25,10 @@
 #include <drm/drm_encoder_slave.h>
 #include <drm/bridge/dw_hdmi.h>
 
+#include <video/display_timing.h>
+#include <video/videomode.h>
+#include <video/of_display_timing.h>
+
 #include <uapi/linux/videodev2.h>
 
 #include "rockchip_drm_drv.h"
@@ -106,8 +110,12 @@ struct rockchip_hdmi {
 	unsigned int colordepth;
 	unsigned int colorimetry;
 	unsigned int phy_bus_width;
+
 	unsigned int hdmi_quant_range;
 	enum drm_hdmi_output_type hdmi_output;
+	bool timing_force_output;
+	struct drm_display_mode force_mode;
+	u32 force_bus_format;
 };
 
 #define to_rockchip_hdmi(x)	container_of(x, struct rockchip_hdmi, x)
@@ -426,6 +434,8 @@ static int rockchip_hdmi_parse_dt(struct rockchip_hdmi *hdmi)
 	struct device_node *np = hdmi->dev->of_node;
 	int ret, val, phy_table_size;
 	u32 *phy_config;
+	struct display_timing timing;
+	struct videomode vm;
 
 	hdmi->regmap = syscon_regmap_lookup_by_phandle(np, "rockchip,grf");
 	if (IS_ERR(hdmi->regmap)) {
@@ -508,6 +518,24 @@ static int rockchip_hdmi_parse_dt(struct rockchip_hdmi *hdmi)
 		dev_dbg(hdmi->dev, "use default hdmi phy table\n");
 	}
 
+	if (of_property_read_bool(np, "force-output")) {
+		hdmi->timing_force_output = true;
+
+		ret = of_get_display_timing(np, "force_timing", &timing);
+		if (ret < 0) {
+			dev_err(hdmi->dev, "can't get force timing\n");
+			hdmi->timing_force_output = false;
+			return ret;
+		}
+
+		videomode_from_timing(&timing, &vm);
+		drm_display_mode_from_videomode(&vm, &hdmi->force_mode);
+		hdmi->force_mode.type |= DRM_MODE_TYPE_PREFERRED;
+
+		if (of_property_read_u32(np, "force-bus-format", &hdmi->force_bus_format))
+			hdmi->force_bus_format = MEDIA_BUS_FMT_RGB888_1X24;
+	}
+
 	return 0;
 }
 
@@ -816,6 +844,45 @@ dw_hdmi_rockchip_select_output(struct drm_connector_state *conn_state,
 	}
 }
 
+static void parse_bus_format(u32 bus_format, u32 *format, u32 *colordepth)
+{
+	switch (bus_format) {
+	case MEDIA_BUS_FMT_RGB101010_1X30:
+		*format = DRM_HDMI_OUTPUT_DEFAULT_RGB;
+		*colordepth = 10;
+		break;
+	case MEDIA_BUS_FMT_YUV8_1X24:
+		*format = DRM_HDMI_OUTPUT_YCBCR444;
+		*colordepth = 8;
+		break;
+	case MEDIA_BUS_FMT_YUV10_1X30:
+		*format = DRM_HDMI_OUTPUT_YCBCR444;
+		*colordepth = 10;
+		break;
+	case MEDIA_BUS_FMT_UYVY10_1X20:
+	case MEDIA_BUS_FMT_YUYV10_1X20:
+		*format = DRM_HDMI_OUTPUT_YCBCR422;
+		*colordepth = 10;
+		break;
+	case MEDIA_BUS_FMT_UYVY8_1X16:
+	case MEDIA_BUS_FMT_YUYV8_1X16:
+		*format = DRM_HDMI_OUTPUT_YCBCR422;
+		*colordepth = 8;
+		break;
+	case MEDIA_BUS_FMT_UYYVYY8_0_5X24:
+		*format = DRM_HDMI_OUTPUT_YCBCR420;
+		*colordepth = 8;
+		break;
+	case MEDIA_BUS_FMT_UYYVYY10_0_5X30:
+		*format = DRM_HDMI_OUTPUT_YCBCR420;
+		*colordepth = 10;
+		break;
+	default:
+		*format = DRM_HDMI_OUTPUT_DEFAULT_RGB;
+		*colordepth = 8;
+	}
+}
+
 static int
 dw_hdmi_rockchip_encoder_atomic_check(struct drm_encoder *encoder,
 				      struct drm_crtc_state *crtc_state,
@@ -829,6 +896,9 @@ dw_hdmi_rockchip_encoder_atomic_check(struct drm_encoder *encoder,
 				       &colorformat, &colordepth,
 				       &hdmi->enc_out_encoding, &s->eotf);
 
+	if (hdmi->timing_force_output)
+		parse_bus_format(hdmi->force_bus_format, &colorformat, &colordepth);
+
 	if (colorformat == DRM_HDMI_OUTPUT_YCBCR420) {
 		s->output_mode = ROCKCHIP_OUT_MODE_YUV420;
 		if (colordepth > 8)
@@ -929,6 +999,16 @@ dw_hdmi_rockchip_get_quant_range(void *data)
 	return hdmi->hdmi_quant_range;
 }
 
+static struct drm_display_mode *dw_hdmi_rockchip_get_force_timing(void *data)
+{
+	struct rockchip_hdmi *hdmi = (struct rockchip_hdmi *)data;
+
+	if (!hdmi->timing_force_output)
+		return NULL;
+
+	return &hdmi->force_mode;
+}
+
 static const struct drm_prop_enum_list color_depth_enum_list[] = {
 	{ 0, "Automatic" }, /* Same as 24bit */
 	{ 8, "24bit" },
@@ -964,39 +1044,7 @@ dw_hdmi_rockchip_attatch_properties(struct drm_connector *connector,
 	struct rockchip_hdmi *hdmi = (struct rockchip_hdmi *)data;
 	struct drm_property *prop;
 
-	switch (color) {
-	case MEDIA_BUS_FMT_RGB101010_1X30:
-		hdmi->hdmi_output = DRM_HDMI_OUTPUT_DEFAULT_RGB;
-		hdmi->colordepth = 10;
-		break;
-	case MEDIA_BUS_FMT_YUV8_1X24:
-		hdmi->hdmi_output = DRM_HDMI_OUTPUT_YCBCR444;
-		hdmi->colordepth = 8;
-		break;
-	case MEDIA_BUS_FMT_YUV10_1X30:
-		hdmi->hdmi_output = DRM_HDMI_OUTPUT_YCBCR444;
-		hdmi->colordepth = 10;
-		break;
-	case MEDIA_BUS_FMT_UYVY10_1X20:
-		hdmi->hdmi_output = DRM_HDMI_OUTPUT_YCBCR422;
-		hdmi->colordepth = 10;
-		break;
-	case MEDIA_BUS_FMT_UYVY8_1X16:
-		hdmi->hdmi_output = DRM_HDMI_OUTPUT_YCBCR422;
-		hdmi->colordepth = 8;
-		break;
-	case MEDIA_BUS_FMT_UYYVYY8_0_5X24:
-		hdmi->hdmi_output = DRM_HDMI_OUTPUT_YCBCR420;
-		hdmi->colordepth = 8;
-		break;
-	case MEDIA_BUS_FMT_UYYVYY10_0_5X30:
-		hdmi->hdmi_output = DRM_HDMI_OUTPUT_YCBCR420;
-		hdmi->colordepth = 10;
-		break;
-	default:
-		hdmi->hdmi_output = DRM_HDMI_OUTPUT_DEFAULT_RGB;
-		hdmi->colordepth = 8;
-	}
+	parse_bus_format(color, &hdmi->hdmi_output, &hdmi->colordepth);
 
 	/* RK3368 does not support deep color mode */
 	if (!hdmi->color_depth_property && hdmi->dev_type != RK3368_HDMI) {
@@ -1359,6 +1407,9 @@ static int dw_hdmi_rockchip_bind(struct device *dev, struct device *master,
 		dw_hdmi_rockchip_get_enc_out_encoding;
 	plat_data->get_quant_range =
 		dw_hdmi_rockchip_get_quant_range;
+	plat_data->get_force_timing =
+		dw_hdmi_rockchip_get_force_timing;
+
 	plat_data->property_ops = &dw_hdmi_rockchip_property_ops;
 
 	if (hdmi->dev_type == RK3328_HDMI || hdmi->dev_type == RK3228_HDMI) {
diff --git a/include/drm/bridge/dw_hdmi.h b/include/drm/bridge/dw_hdmi.h
index fa415d8f272954..499450bba23e25 100644
--- a/include/drm/bridge/dw_hdmi.h
+++ b/include/drm/bridge/dw_hdmi.h
@@ -183,6 +183,8 @@ struct dw_hdmi_plat_data {
 	unsigned long (*get_enc_out_encoding)(void *data);
 	unsigned long (*get_quant_range)(void *data);
 
+	struct drm_display_mode *(*get_force_timing)(void *data);
+
 	/* Vendor Property support */
 	const struct dw_hdmi_property_ops *property_ops;
 };
-- 
2.17.1

