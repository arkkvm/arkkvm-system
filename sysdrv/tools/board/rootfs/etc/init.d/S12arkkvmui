# description: ARKKVMUI Startup Script
#
# BACKUP ONLY in arkkvm-display-app/script/. Device boots from
# jack-build-system board rootfs:
#   .../sysdrv/tools/board/rootfs/etc/init.d/S12arkkvmui

APP_PATH=/oem/usr/bin/arkkvm_ui
APP_NAME=ARKKVMUI
PID_FILE=/run/$APP_NAME.pid
LOG_FILE=/userdata/arkkvm/log/arkkvm_ui.log
LOG_GUARD_PID=/run/arkkvm_ui_log_guard.pid

[ -f /etc/profile.d/RkEnv.sh ] && source /etc/profile.d/RkEnv.sh

LOG_CAP_LIB=/oem/usr/bin/arkkvm_log_cap.sh
[ -f "$LOG_CAP_LIB" ] || LOG_CAP_LIB="$(dirname "$0")/arkkvm_log_cap.sh"
ARKKVM_LOG_CAP_LOADED=0
# UI redirect log cap: 20 MiB (app/usb default is 50 MiB)
ARKKVM_LOG_MAX_BYTES=20971520
# shellcheck source=/dev/null
if [ -f "$LOG_CAP_LIB" ]; then
    . "$LOG_CAP_LIB"
    ARKKVM_LOG_CAP_LOADED=1
fi

case "$1" in
    start)
        echo "Starting $APP_NAME..."
        if [ -f $PID_FILE ]; then
            if ps -p $(cat $PID_FILE) > /dev/null 2>&1; then
                echo "$APP_NAME is already running (PID: $(cat $PID_FILE))"
                exit 0
            else
                echo "Removing stale PID file..."
                rm -f $PID_FILE
            fi
        fi
        mkdir -p /userdata/arkkvm/log
        mount -t debugfs debugfs /sys/kernel/debug/ 2>/dev/null
        if [ "$ARKKVM_LOG_CAP_LOADED" = 1 ]; then
            cap_log_file "$LOG_FILE"
        fi
        # sleep 后 exec 替换同 PID，PID 文件与真实 arkkvm_ui 一致
        nohup sh -c "sleep 1; exec $APP_PATH" >> "$LOG_FILE" 2>&1 &
        echo $! > $PID_FILE
        echo "$APP_NAME started with PID $!. $LOG_FILE"

        if [ "$ARKKVM_LOG_CAP_LOADED" = 1 ]; then
            start_log_guard "$LOG_FILE" "$LOG_GUARD_PID"
        fi
        ;;
    stop)
        echo "Stopping $APP_NAME..."
        if [ "$ARKKVM_LOG_CAP_LOADED" = 1 ]; then
            stop_log_guard "$LOG_GUARD_PID"
        else
            [ -f "$LOG_GUARD_PID" ] && kill "$(cat "$LOG_GUARD_PID")" 2>/dev/null; rm -f "$LOG_GUARD_PID"
        fi
        if [ -f $PID_FILE ]; then
            PID=$(cat $PID_FILE)
            if ps -p $PID > /dev/null 2>&1; then
                kill $PID
                echo "$APP_NAME stopped (PID: $PID)"
            else
                echo "No running process found for PID $PID"
                killall -TERM arkkvm_ui 2>/dev/null || true
            fi
            rm -f $PID_FILE
        else
            echo "PID file not found: $PID_FILE"
        fi
        ;;
    restart)
        $0 stop
        sleep 2
        $0 start
        ;;
    status)
        if [ -f $PID_FILE ]; then
            PID=$(cat $PID_FILE)
            if ps -p $PID > /dev/null 2>&1; then
                echo "$APP_NAME is running (PID: $PID)"
            else
                echo "$APP_NAME PID file exists but process not running"
            fi
        else
            echo "$APP_NAME is not running"
        fi
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit 0
