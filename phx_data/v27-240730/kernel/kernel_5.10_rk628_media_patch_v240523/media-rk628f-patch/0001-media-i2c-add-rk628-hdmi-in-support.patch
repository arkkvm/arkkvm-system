+static int rk628_csi_s_ctrl_detect_tx_5v(struct v4l2_subdev *sd)
+{
+	struct rk628_csi *csi = to_csi(sd);
+
+	return v4l2_ctrl_s_ctrl(csi->detect_tx_5v_ctrl,
+			tx_5v_power_present(sd));
+}
