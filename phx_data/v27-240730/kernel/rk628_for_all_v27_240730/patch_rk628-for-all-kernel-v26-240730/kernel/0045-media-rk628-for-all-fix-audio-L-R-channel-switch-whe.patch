+static int rk628_hdmirx_phy_power_off(struct v4l2_subdev *sd)
+{
+	struct rk628_csi *csi = to_csi(sd);
+
+	if (csi->rxphy_pwron) {
+		v4l2_dbg(1, debug, sd, "rxphy power off!\n");
+		rk628_rxphy_power_off(csi->rk628);
+		csi->rxphy_pwron = false;
+	}
+	usleep_range(100, 100);
+
+	return 0;
+}
