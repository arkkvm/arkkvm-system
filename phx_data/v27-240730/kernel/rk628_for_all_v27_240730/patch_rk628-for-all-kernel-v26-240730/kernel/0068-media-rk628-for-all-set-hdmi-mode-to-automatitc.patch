From 76e6a9b891e50d6c5bd8bcb27d55763b3b7c2aca Mon Sep 17 00:00:00 2001
From: Shunqing Chen <csq@rock-chips.com>
Date: Fri, 13 Aug 2021 09:14:05 +0800
Subject: [PATCH 068/232] media: rk628-for-all: set hdmi mode to automatitc

Signed-off-by: Shunqing Chen <csq@rock-chips.com>
Change-Id: I49051666c89269a615b564088506052c5c2b9ce8
Signed-off-by: Guochun Huang <hero.huang@rock-chips.com>
---
 drivers/media/i2c/rk628/rk628.c             | 1 +
 drivers/media/i2c/rk628/rk628_bt1120_v4l2.c | 4 ++++
 drivers/media/i2c/rk628/rk628_csi.c         | 4 ++++
 drivers/media/i2c/rk628/rk628_csi_v4l2.c    | 4 ++++
 drivers/media/i2c/rk628/rk628_hdmirx.c      | 2 +-
 drivers/media/i2c/rk628/rk628_hdmirx.h      | 2 ++
 6 files changed, 16 insertions(+), 1 deletion(-)

diff --git a/drivers/media/i2c/rk628/rk628.c b/drivers/media/i2c/rk628/rk628.c
index a163087cd58bb8..5e07873275bb5e 100644
--- a/drivers/media/i2c/rk628/rk628.c
+++ b/drivers/media/i2c/rk628/rk628.c
@@ -159,6 +159,7 @@ static const struct regmap_range rk628_hdmirx_readable_ranges[] = {
 	regmap_reg_range(HDMI_RX_PDEC_CTRL, HDMI_RX_PDEC_CTRL),
 	regmap_reg_range(HDMI_RX_PDEC_AUDIODET_CTRL, HDMI_RX_PDEC_AUDIODET_CTRL),
 	regmap_reg_range(HDMI_RX_PDEC_ERR_FILTER, HDMI_RX_PDEC_ASP_CTRL),
+	regmap_reg_range(HDMI_RX_PDEC_STS, HDMI_RX_PDEC_STS),
 	regmap_reg_range(HDMI_RX_PDEC_GCP_AVMUTE, HDMI_RX_PDEC_GCP_AVMUTE),
 	regmap_reg_range(HDMI_RX_PDEC_ACR_CTS, HDMI_RX_PDEC_ACR_N),
 	regmap_reg_range(HDMI_RX_PDEC_AIF_CTRL, HDMI_RX_PDEC_AIF_PB0),
diff --git a/drivers/media/i2c/rk628/rk628_bt1120_v4l2.c b/drivers/media/i2c/rk628/rk628_bt1120_v4l2.c
index e5fc70d9044288..d3873df9037eab 100644
--- a/drivers/media/i2c/rk628/rk628_bt1120_v4l2.c
+++ b/drivers/media/i2c/rk628/rk628_bt1120_v4l2.c
@@ -991,6 +991,10 @@ static int rk628_hdmirx_phy_setup(struct v4l2_subdev *sd)
 					width, height, frame_width,
 					frame_height, status, cnt);
 
+			rk628_i2c_read(bt1120->rk628, HDMI_RX_PDEC_STS, &val);
+			if (val & DVI_DET)
+				dev_info(bt1120->dev, "DVI mode detected\n");
+
 			if (!tx_5v_power_present(sd)) {
 				v4l2_info(sd, "HDMI pull out, return!\n");
 				return -1;
diff --git a/drivers/media/i2c/rk628/rk628_csi.c b/drivers/media/i2c/rk628/rk628_csi.c
index f790cfd1474415..0725acb8673f14 100644
--- a/drivers/media/i2c/rk628/rk628_csi.c
+++ b/drivers/media/i2c/rk628/rk628_csi.c
@@ -1075,6 +1075,10 @@ static int rk628_hdmirx_phy_setup(struct rk628_csi *csi)
 				__func__, width, height, frame_width,
 				frame_height, status, cnt);
 
+			rk628_i2c_read(csi->rk628, HDMI_RX_PDEC_STS, &val);
+			if (val & DVI_DET)
+				dev_info(csi->dev, "DVI mode detected\n");
+
 			if (!tx_5v_power_present(csi)) {
 				dev_info(csi->dev, "HDMI pull out, return!\n");
 				return -1;
diff --git a/drivers/media/i2c/rk628/rk628_csi_v4l2.c b/drivers/media/i2c/rk628/rk628_csi_v4l2.c
index 733addef88044a..0b0429ce1e6753 100644
--- a/drivers/media/i2c/rk628/rk628_csi_v4l2.c
+++ b/drivers/media/i2c/rk628/rk628_csi_v4l2.c
@@ -1102,6 +1102,10 @@ static int rk628_hdmirx_phy_setup(struct v4l2_subdev *sd)
 					width, height, frame_width,
 					frame_height, status, cnt);
 
+			rk628_i2c_read(csi->rk628, HDMI_RX_PDEC_STS, &val);
+			if (val & DVI_DET)
+				dev_info(csi->dev, "DVI mode detected\n");
+
 			if (!tx_5v_power_present(sd)) {
 				v4l2_info(sd, "HDMI pull out, return!\n");
 				return -1;
diff --git a/drivers/media/i2c/rk628/rk628_hdmirx.c b/drivers/media/i2c/rk628/rk628_hdmirx.c
index 00179c73f24ff5..dc780be2e0aefd 100644
--- a/drivers/media/i2c/rk628/rk628_hdmirx.c
+++ b/drivers/media/i2c/rk628/rk628_hdmirx.c
@@ -168,7 +168,7 @@ void rk628_hdmirx_set_hdcp(struct rk628 *rk628, struct rk628_hdcp *hdcp, bool en
 void rk628_hdmirx_controller_setup(struct rk628 *rk628)
 {
 	rk628_i2c_write(rk628, HDMI_RX_HDMI20_CONTROL, 0x10001f10);
-	rk628_i2c_write(rk628, HDMI_RX_HDMI_MODE_RECOVER, 0x000000e1);
+	rk628_i2c_write(rk628, HDMI_RX_HDMI_MODE_RECOVER, 0x00000021);
 	rk628_i2c_write(rk628, HDMI_RX_PDEC_CTRL, 0xbfff8011);
 	rk628_i2c_write(rk628, HDMI_RX_PDEC_ASP_CTRL, 0x00000040);
 	rk628_i2c_write(rk628, HDMI_RX_HDMI_RESMPL_CTRL, 0x00000001);
diff --git a/drivers/media/i2c/rk628/rk628_hdmirx.h b/drivers/media/i2c/rk628/rk628_hdmirx.h
index c1db647526f27c..4bc21d3c4ed76b 100644
--- a/drivers/media/i2c/rk628/rk628_hdmirx.h
+++ b/drivers/media/i2c/rk628/rk628_hdmirx.h
@@ -231,6 +231,8 @@
 #define DELTACTS_IRQTRIG(x)		UPDATE(x, 4, 2)
 #define HDMI_RX_PDEC_ERR_FILTER     	(HDMI_RX_BASE + 0x033c)
 #define HDMI_RX_PDEC_ASP_CTRL       	(HDMI_RX_BASE + 0x0340)
+#define HDMI_RX_PDEC_STS		(HDMI_RX_BASE + 0x0360)
+#define DVI_DET				BIT(28)
 #define HDMI_RX_PDEC_GCP_AVMUTE       	(HDMI_RX_BASE + 0x0380)
 #define HDMI_RX_PDEC_AVI_PB		(HDMI_RX_BASE + 0x03a4)
 #define VIDEO_FORMAT_MASK		GENMASK(6, 5)
-- 
2.17.1

