-struct i2c_client *rk628_i2c = NULL;
-
+#ifndef RK628_REGMAP
 static int i2c_read(struct i2c_client *i2c, u32 reg, u32 *val)
 {
 	int ret;
@@ -43,7 +44,6 @@ static int i2c_read(struct i2c_client *i2c, u32 reg, u32 *val)
 	}
 
 	return 0;
-
 }
 
 static int i2c_write(struct i2c_client *i2c, u32 reg, u32 val)
@@ -72,340 +72,247 @@ static int i2c_write(struct i2c_client *i2c, u32 reg, u32 val)
 	return 0;
 }
 
-void rk628_i2c_write(u32 reg, u32 val)
+int rk628_i2c_write(struct rk628 *rk628, u32 reg, u32 val)
 {
-	if (!rk628_i2c)
-		return;
-
-	i2c_write(rk628_i2c, reg, val);
+	return i2c_write(rk628->client, reg, val);
 }
-EXPORT_SYMBOL_GPL(rk628_i2c_write);
 
-int rk628_i2c_read(u32 reg, u32 *val)
+int rk628_i2c_read(struct rk628 *rk628, u32 reg, u32 *val)
 {
-	if (!rk628_i2c)
-		return -1;
-
-	return i2c_read(rk628_i2c, reg, val);
+	return i2c_read(rk628->client, reg, val);
 }
-EXPORT_SYMBOL_GPL(rk628_i2c_read);
 
-void rk628_i2c_update_bits(u32 reg, u32 mask, u32 val)
+int rk628_i2c_update_bits(struct rk628 *rk628, u32 reg, u32 mask, u32 val)
 {
 	u32 orig, tmp;
 
-	if (!rk628_i2c)
-		return;
-
-	i2c_read(rk628_i2c, reg, &orig);
+	i2c_read(rk628->client, reg, &orig);
 	tmp = orig & ~mask;
 	tmp |= val & mask;
-	i2c_write(rk628_i2c, reg, tmp);
+	return i2c_write(rk628->client, reg, tmp);
 }
-EXPORT_SYMBOL_GPL(rk628_i2c_update_bits);
 
