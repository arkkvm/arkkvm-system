+#define UPDATE(x, h, l)		(((x) << (l)) & GENMASK((h), (l)))
+#define HIWORD_UPDATE(v, h, l)	(((v) << (l)) | (GENMASK((h), (l)) << 16))
+
+
+/* --------- EDID and HDCP KEY ------- */
+#define EDID_BASE			0x000a0000
+#define HDCP_KEY_BASE			0x000a8000
+#define KEY_MAX_REGISTER		0x000a8490
+
