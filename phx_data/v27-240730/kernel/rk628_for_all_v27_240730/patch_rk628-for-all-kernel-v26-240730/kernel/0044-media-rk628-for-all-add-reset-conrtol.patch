From: Shunqing Chen <csq@rock-chips.com>
Date: Wed, 4 Aug 2021 09:18:52 +0800
Subject: [PATCH 044/232] media: rk628-for-all: add reset conrtol

Signed-off-by: Shunqing Chen <csq@rock-chips.com>
Change-Id: Ib75c6d5fefcb080889c95e74c9d5afdc9b8804f4
Signed-off-by: Guochun Huang <hero.huang@rock-chips.com>
---
 drivers/media/i2c/rk628/rk628_bt1120_v4l2.c | 37 ++++++++++++++++++-
 drivers/media/i2c/rk628/rk628_combrxphy.c   | 16 +++++++-
 drivers/media/i2c/rk628/rk628_combtxphy.c   |  6 +++
 drivers/media/i2c/rk628/rk628_csi.c         | 41 ++++++++++++++++++++-
 drivers/media/i2c/rk628/rk628_csi_v4l2.c    | 41 ++++++++++++++++++++-
 5 files changed, 136 insertions(+), 5 deletions(-)

diff --git a/drivers/media/i2c/rk628/rk628_bt1120_v4l2.c b/drivers/media/i2c/rk628/rk628_bt1120_v4l2.c
index c292cdf7ca9cb0..44e244a935db19 100644
--- a/drivers/media/i2c/rk628/rk628_bt1120_v4l2.c
+++ b/drivers/media/i2c/rk628/rk628_bt1120_v4l2.c
@@ -797,8 +797,22 @@ static void rk628_post_process_setup(struct v4l2_subdev *sd)
 	/* do not scale now */
 	dst = src;
 
+	rk628_control_assert(bt1120->rk628, RGU_DECODER);
+	udelay(10);
+	rk628_control_deassert(bt1120->rk628, RGU_DECODER);
+	udelay(10);
+
 	rk628_clk_set_rate(bt1120->rk628, CGU_CLK_RX_READ, src.pixelclock);
+	rk628_control_assert(bt1120->rk628, RGU_CLK_RX);
+	udelay(10);
+	rk628_control_deassert(bt1120->rk628, RGU_CLK_RX);
+	udelay(10);
+
 	rk628_clk_set_rate(bt1120->rk628, CGU_SCLK_VOP, src.pixelclock);
+	rk628_control_assert(bt1120->rk628, RGU_VOP);
+	udelay(10);
+	rk628_control_deassert(bt1120->rk628, RGU_VOP);
+	udelay(10);
 
 	rk628_post_process_scaler_init(sd, &src, &dst);
 }
@@ -825,9 +839,9 @@ static int rk628_hdmirx_phy_power_on(struct v4l2_subdev *sd)
 			v4l2_err(sd, "hdmi rxphy power off failed!\n");
 		else
 			bt1120->rxphy_pwron = false;
+		usleep_range(100, 100);
 	}
 
-	usleep_range(100, 100);
 	if (bt1120->rxphy_pwron == false) {
 		ret = rk628_rxphy_power_on(bt1120->rk628, f);
 		if (ret) {
@@ -859,6 +873,10 @@ static void rk628_hdmirx_controller_reset(struct v4l2_subdev *sd)
 {
 	struct rk628_bt1120 *bt1120 = to_bt1120(sd);
 
+	rk628_control_assert(bt1120->rk628, RGU_HDMIRX_PON);
+	udelay(10);
+	rk628_control_deassert(bt1120->rk628, RGU_HDMIRX_PON);
+	udelay(10);
 	rk628_i2c_write(bt1120->rk628, HDMI_RX_DMI_SW_RST, 0x000101ff);
 	rk628_i2c_write(bt1120->rk628, HDMI_RX_DMI_DISABLE_IF, 0x00000000);
 	rk628_i2c_write(bt1120->rk628, HDMI_RX_DMI_DISABLE_IF, 0x0000017f);
@@ -1139,6 +1157,16 @@ static void rk628_bt1120_initial_setup(struct v4l2_subdev *sd)
 	/* hdmirx int en */
 	rk628_i2c_write(bt1120->rk628, GRF_INTR0_EN, 0x01000100);
 
+	udelay(10);
+	rk628_control_assert(bt1120->rk628, RGU_HDMIRX);
+	rk628_control_assert(bt1120->rk628, RGU_HDMIRX_PON);
+	rk628_control_assert(bt1120->rk628, RGU_BT1120DEC);
+	udelay(10);
+	rk628_control_deassert(bt1120->rk628, RGU_HDMIRX);
+	rk628_control_deassert(bt1120->rk628, RGU_HDMIRX_PON);
+	rk628_control_deassert(bt1120->rk628, RGU_BT1120DEC);
+	udelay(10);
+
 	/* pinctrl for vop pin */
 	rk628_i2c_write(bt1120->rk628, GRF_GPIO2AB_SEL_CON, 0xffffffff);
 	rk628_i2c_write(bt1120->rk628, GRF_GPIO2C_SEL_CON, 0xffff5555);
@@ -2149,6 +2177,13 @@ static int rk628_bt1120_remove(struct i2c_client *client)
 
 	mutex_destroy(&bt1120->confctl_mutex);
 
+	rk628_control_assert(bt1120->rk628, RGU_HDMIRX);
+	rk628_control_assert(bt1120->rk628, RGU_HDMIRX_PON);
+	rk628_control_assert(bt1120->rk628, RGU_DECODER);
+	rk628_control_assert(bt1120->rk628, RGU_CLK_RX);
+	rk628_control_assert(bt1120->rk628, RGU_VOP);
+	rk628_control_assert(bt1120->rk628, RGU_BT1120DEC);
+
 	return 0;
 }
 
diff --git a/drivers/media/i2c/rk628/rk628_combrxphy.c b/drivers/media/i2c/rk628/rk628_combrxphy.c
index 462552ffc88b0c..ba39cd93395ec4 100644
--- a/drivers/media/i2c/rk628/rk628_combrxphy.c
+++ b/drivers/media/i2c/rk628/rk628_combrxphy.c
@@ -15,7 +15,7 @@
 #include <linux/reset.h>
 #include "rk628.h"
 #include "rk628_combrxphy.h"
-
+#include "rk628_cru.h"
 
 #define COMBRXPHY_MAX_REGISTER	COMBRX_REG(0x6790)
 
@@ -23,7 +23,7 @@
 #define MAX_DATA_NUM		16
 #define MAX_CHANNEL		3
 #define CLK_DET_TRY_TIMES	10
-#define CHECK_CNT  50
+#define CHECK_CNT		100
 #define CLK_STABLE_LOOP_CNT	10
 #define CLK_STABLE_THRESHOLD	6
 
@@ -33,6 +33,10 @@ static int rk628_combrxphy_try_clk_detect(struct rk628 *rk628)
 	int ret;
 
 	ret = -1;
+	rk628_control_assert(rk628, RGU_RXPHY);
+	usleep_range(10, 20);
+	rk628_control_deassert(rk628, RGU_RXPHY);
+	usleep_range(10, 20);
 
 	/* step1: set pin_rst_n to 1’b0.wait 1 period(1us).release reset */
 	/* step2: select pll clock src and enable auto check */
@@ -538,12 +542,20 @@ static int rk628_combrxphy_set_hdmi_mode_for_cable(struct rk628 *rk628, int f)
 
 int rk628_rxphy_power_on(struct rk628 *rk628, int f)
 {
+	rk628_control_assert(rk628, RGU_RXPHY);
+	udelay(10);
+	rk628_control_deassert(rk628, RGU_RXPHY);
+	udelay(10);
+
 	return rk628_combrxphy_set_hdmi_mode_for_cable(rk628, f);
 }
 
 int rk628_rxphy_power_off(struct rk628 *rk628)
 {
 	rk628_i2c_update_bits(rk628, COMBRX_REG(0x6630), BIT(0), BIT(0));
+	rk628_control_assert(rk628, RGU_RXPHY);
+	udelay(10);
+
 	return 0;
 }
 
diff --git a/drivers/media/i2c/rk628/rk628_combtxphy.c b/drivers/media/i2c/rk628/rk628_combtxphy.c
index 4778be97f5023f..ba34475cc921d3 100644
--- a/drivers/media/i2c/rk628/rk628_combtxphy.c
+++ b/drivers/media/i2c/rk628/rk628_combtxphy.c
@@ -8,6 +8,7 @@
 #include <linux/delay.h>
 #include "rk628.h"
 #include "rk628_combtxphy.h"
+#include "rk628_cru.h"
 
 struct rk628_combtxphy {
 	enum phy_mode mode;
@@ -201,6 +202,11 @@ void rk628_txphy_set_mode(struct rk628 *rk628, enum phy_mode mode)
 
 void rk628_txphy_power_on(struct rk628 *rk628)
 {
+	rk628_control_assert(rk628, RGU_TXPHY_CON);
+	udelay(10);
+	rk628_control_deassert(rk628, RGU_TXPHY_CON);
+	udelay(10);
+
 	rk628_i2c_update_bits(rk628,  COMBTXPHY_CON0, SW_TX_IDLE_MASK | SW_TX_PD_MASK |
 			      SW_PD_PLL_MASK, SW_TX_IDLE(0x3ff) |
 			      SW_TX_PD(0x3ff) | SW_PD_PLL);
diff --git a/drivers/media/i2c/rk628/rk628_csi.c b/drivers/media/i2c/rk628/rk628_csi.c
