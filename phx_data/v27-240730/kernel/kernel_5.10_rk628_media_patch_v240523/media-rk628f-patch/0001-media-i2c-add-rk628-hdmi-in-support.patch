+static void rk628_csi_work_i2c_poll(struct work_struct *work)
+{
+	struct rk628_csi *csi = container_of(work, struct rk628_csi,
+			work_i2c_poll);
+	struct v4l2_subdev *sd = &csi->sd;
+
+	rk628_csi_format_change(sd);
+}
