+		v4l2_dbg(1, debug, sd, "%s: %#x %d\n", __func__, mask, en);
+		rk628_i2c_update_bits(HDMI_RX_DMI_DISABLE_IF,
+				   mask, HDMI_ENABLE(1) | AUD_ENABLE(1));
+	} else {
+		mask = AUD_ENABLE_MASK | HDMI_ENABLE_MASK;
+		v4l2_dbg(1, debug, sd, "%s: %#x %d\n", __func__, mask, en);
+		rk628_i2c_update_bits(HDMI_RX_DMI_DISABLE_IF,
+				   mask, HDMI_ENABLE(0) | AUD_ENABLE(0));
+	}
 }
 
