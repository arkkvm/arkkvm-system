From 314b7466ff3c9565e4555129e37f72a5634a19ac Mon Sep 17 00:00:00 2001
From: Jianwei Fan <jianwei.fan@rock-chips.com>
Date: Fri, 15 Mar 2024 14:59:37 +0800
Subject: [PATCH 59/82] media: i2c: rk628: remove mutex lock in
 g_frame_interval

Signed-off-by: Jianwei Fan <jianwei.fan@rock-chips.com>
Change-Id: I0efe96ae6fccfac7d49044f3253e07f94dd71956
---
 drivers/media/i2c/rk628/rk628_bt1120_v4l2.c | 2 --
 drivers/media/i2c/rk628/rk628_csi_v4l2.c    | 2 --
 2 files changed, 4 deletions(-)

diff --git a/drivers/media/i2c/rk628/rk628_bt1120_v4l2.c b/drivers/media/i2c/rk628/rk628_bt1120_v4l2.c
index 0a713ae6d37d..e9bc8b85a42d 100644
--- a/drivers/media/i2c/rk628/rk628_bt1120_v4l2.c
+++ b/drivers/media/i2c/rk628/rk628_bt1120_v4l2.c
@@ -1496,9 +1496,7 @@ static int rk628_bt1120_g_frame_interval(struct v4l2_subdev *sd,
 	struct rk628_bt1120 *bt1120 = to_bt1120(sd);
 	const struct rk628_bt1120_mode *mode = bt1120->cur_mode;
 
-	mutex_lock(&bt1120->confctl_mutex);
 	fi->interval = mode->max_fps;
-	mutex_unlock(&bt1120->confctl_mutex);
 
 	return 0;
 }
diff --git a/drivers/media/i2c/rk628/rk628_csi_v4l2.c b/drivers/media/i2c/rk628/rk628_csi_v4l2.c
index de84320c6815..83b1c63a97eb 100644
--- a/drivers/media/i2c/rk628/rk628_csi_v4l2.c
+++ b/drivers/media/i2c/rk628/rk628_csi_v4l2.c
@@ -2166,9 +2166,7 @@ static int rk628_csi_g_frame_interval(struct v4l2_subdev *sd,
 	struct rk628_csi *csi = to_csi(sd);
 	const struct rk628_csi_mode *mode = csi->cur_mode;
 
-	mutex_lock(&csi->confctl_mutex);
 	fi->interval = mode->max_fps;
-	mutex_unlock(&csi->confctl_mutex);
 
 	return 0;
 }
-- 
2.17.1

