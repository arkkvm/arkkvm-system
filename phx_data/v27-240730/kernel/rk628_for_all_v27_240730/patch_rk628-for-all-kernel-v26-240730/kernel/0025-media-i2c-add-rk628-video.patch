+static void rk628_hdmirx_config_all(struct v4l2_subdev *sd)
+{
+	int ret;
+	struct rk628_csi *csi = to_csi(sd);
+
+	rk628_hdmirx_controller_setup(sd);
+	ret = rk628_hdmirx_phy_setup(sd);
+	if (ret >= 0) {
+		rk628_csi_format_change(sd);
+		csi->nosignal = false;
+	}
+}
