+#define HOT_PLUG_DETECT_INPUT_A(x)	UPDATE(x, 24, 24)
+#define HOT_PLUG_DETECT_MASK       	BIT(0)
+#define HOT_PLUG_DETECT(x)		UPDATE(x, 0, 0)
