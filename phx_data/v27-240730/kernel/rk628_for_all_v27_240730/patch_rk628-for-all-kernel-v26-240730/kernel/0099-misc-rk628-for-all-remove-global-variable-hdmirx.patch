---
 drivers/misc/rk628/rk628.h        |   1 +
 drivers/misc/rk628/rk628_hdmirx.c | 120 ++++++++++++++++++------------
 2 files changed, 73 insertions(+), 48 deletions(-)
 mode change 100755 => 100644 drivers/misc/rk628/rk628.h

diff --git a/drivers/misc/rk628/rk628.h b/drivers/misc/rk628/rk628.h
