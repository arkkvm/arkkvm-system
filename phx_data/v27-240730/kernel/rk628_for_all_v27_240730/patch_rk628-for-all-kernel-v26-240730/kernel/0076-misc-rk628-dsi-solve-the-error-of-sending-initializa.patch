From 4e32b0b1dbaacb07ec2e148e0f1c547e4701c789 Mon Sep 17 00:00:00 2001
From: Guochun Huang <hero.huang@rock-chips.com>
Date: Fri, 20 Aug 2021 12:31:42 +0800
Subject: [PATCH 076/232] misc: rk628: dsi: solve the error of sending
 initialization sequence probability

Signed-off-by: Guochun Huang <hero.huang@rock-chips.com>
Change-Id: Iac14da117daca1c0ef6d4b087fc5df56f5a8bce4
---
 drivers/misc/rk628/rk628_dsi.c | 24 ++++++++++++------------
 1 file changed, 12 insertions(+), 12 deletions(-)

diff --git a/drivers/misc/rk628/rk628_dsi.c b/drivers/misc/rk628/rk628_dsi.c
index a34c4c25afa1aa..3acc05b329257c 100644
--- a/drivers/misc/rk628/rk628_dsi.c
+++ b/drivers/misc/rk628/rk628_dsi.c
@@ -5,9 +5,7 @@
  * Author: Guochun Huang <hero.huang@rock-chips.com>
  */
 
-//#include <video/mipi_display.h>
-//#include <drm/drm_mipi_dsi.h>
-
+#include <asm/unaligned.h>
 #include "rk628.h"
 #include "rk628_cru.h"
 #include "rk628_dsi.h"
@@ -858,8 +856,7 @@ static int rk628_dsi_transfer(struct rk628 *rk628, const struct rk628_dsi *dsi,
 		if (ret)
 			return ret;
 
-		val = packet.payload[3] << 24 | packet.payload[2] << 16 |
-		      packet.payload[1] << 8 | packet.payload[0];
+		val = get_unaligned_le32(packet.payload);
 
 		dev_info(rk628->dev, "dsi payload: 0x%x\n", val);
 
@@ -892,8 +889,7 @@ static int rk628_dsi_transfer(struct rk628 *rk628, const struct rk628_dsi *dsi,
 		return ret;
 
 	/* Send packet header */
-	val = packet.header[3] << 24 | packet.header[2] << 16 |
-	      packet.header[1] << 8 | packet.header[0];
+	val = get_unaligned_le32(packet.header);
 
 	dev_info(rk628->dev, "dsi hdr: 0x%x\n", val);
 
@@ -924,6 +920,7 @@ int rk628_mipi_dsi_generic_write(struct rk628 *rk628,
 	const struct rk628_dsi *dsi = rk628_display_get_dsi0_host();
 	struct mipi_dsi_msg msg;
 
+	memset(&msg, 0, sizeof(msg));
 	msg.channel = dsi->channel;
 	msg.tx_buf = payload;
 	msg.tx_len = size;
@@ -957,6 +954,7 @@ int rk628_mipi_dsi_dcs_write_buffer(struct rk628 *rk628,
 	const struct rk628_dsi *dsi = rk628_display_get_dsi0_host();
 	struct mipi_dsi_msg msg;
 
+	memset(&msg, 0, sizeof(msg));
 	msg.channel = dsi->channel;
 	msg.tx_buf = data;
 	msg.tx_len = len;
@@ -987,6 +985,7 @@ int rk628_mipi_dsi_dcs_read(struct rk628 *rk628, u8 cmd, void *data, size_t len)
 	const struct rk628_dsi *dsi = rk628_display_get_dsi0_host();
 	struct mipi_dsi_msg msg;
 
+	memset(&msg, 0, sizeof(msg));
 	msg.channel = dsi->channel;
 	msg.type = MIPI_DSI_DCS_READ;
 	msg.tx_buf = &cmd;
@@ -1179,11 +1178,11 @@ static void mipi_dphy_init(struct rk628 *rk628, const struct rk628_dsi *dsi)
 	u8 hsfreqrange;
 	unsigned int index;
 
-	for (index = 0; index < 39; index++)
+	for (index = 0; index < ARRAY_SIZE(hsfreqrange_table); index++)
 		if (lane_mbps <= hsfreqrange_table[index].max_lane_mbps)
 			break;
 
-	if (index == 39)
+	if (index == ARRAY_SIZE(hsfreqrange_table))
 		--index;
 
 	hsfreqrange = hsfreqrange_table[index].hsfreqrange;
@@ -1454,16 +1453,18 @@ void rk628_dsi_enable(struct rk628 *rk628)
 
 	/* rst for dsi0 */
 	rk628_dsi0_reset_control_assert(rk628);
-	mdelay(1);
+	usleep_range(20, 40);
 	rk628_dsi0_reset_control_deassert(rk628);
+	usleep_range(20, 40);
 
 	rk628_dsi_bridge_pre_enable(rk628, dsi);
 
 	if (dsi->slave) {
 		/* rst for dsi1 */
 		rk628_dsi1_reset_control_assert(rk628);
-		mdelay(1);
+		usleep_range(20, 40);
 		rk628_dsi1_reset_control_deassert(rk628);
+		usleep_range(20, 40);
 
 		rk628_dsi_bridge_pre_enable(rk628, dsi1);
 	}
@@ -1479,7 +1480,6 @@ void rk628_dsi_enable(struct rk628 *rk628)
 
 	dev_info(rk628->dev, "dsi: mode: 0x%x\n", mode);
 #endif
-
 	rk628_dsi_bridge_enable(rk628, dsi);
 
 	if (dsi->slave)
-- 
