-static void rk628_hdmirx_audio_setup(struct v4l2_subdev *sd)
-{
-	struct rk628_bt1120 *bt1120 = to_bt1120(sd);
-	u32 audio_pll_n, audio_pll_cts;
-
-	audio_pll_n = 5644;
-	audio_pll_cts = 148500;
-	bt1120->audio_state.ctsn_flag = 0;
-	bt1120->audio_state.fs_audio = 0;
-	bt1120->audio_state.pre_state = 0;
-	bt1120->audio_state.init_state = INIT_FIFO_STATE*4;
-	bt1120->audio_state.fifo_int = false;
-	bt1120->fifo_ints_en = false;
-	bt1120->ctsn_ints_en = false;
-
-	rk628_hdmirx_audio_clk_set_rate(sd, 5644800);
-	/* manual aud CTS */
-	rk628_i2c_write(bt1120->rk628, HDMI_RX_AUDPLL_GEN_CTS, audio_pll_cts);
-	/* manual aud N */
-	rk628_i2c_write(bt1120->rk628, HDMI_RX_AUDPLL_GEN_N, audio_pll_n);
-
-	/* aud CTS N en manual */
-	rk628_i2c_update_bits(bt1120->rk628, HDMI_RX_AUD_CLK_CTRL,
-			CTS_N_REF_MASK, CTS_N_REF(1));
-	/* aud pll ctrl */
-	rk628_i2c_update_bits(bt1120->rk628, HDMI_RX_AUD_PLL_CTRL,
-			PLL_LOCK_TOGGLE_DIV_MASK, PLL_LOCK_TOGGLE_DIV(0));
-	rk628_i2c_update_bits(bt1120->rk628, HDMI_RX_AUD_FIFO_TH,
-		AFIF_TH_START_MASK |
-		AFIF_TH_MAX_MASK |
-		AFIF_TH_MIN_MASK,
-		AFIF_TH_START(64) |
-		AFIF_TH_MAX(8) |
-		AFIF_TH_MIN(8));
-
-	/* AUTO_VMUTE */
-	rk628_i2c_update_bits(bt1120->rk628, HDMI_RX_AUD_FIFO_CTRL,
-			AFIF_SUBPACKET_DESEL_MASK |
-			AFIF_SUBPACKETS_MASK,
-			AFIF_SUBPACKET_DESEL(0) |
-			AFIF_SUBPACKETS(1));
-	rk628_i2c_write(bt1120->rk628, HDMI_RX_AUD_SAO_CTRL,
-			I2S_LPCM_BPCUV(0) |
-			I2S_32_16(1) |
-			I2S_ENABLE_BITS(0x3f));
-	rk628_i2c_write(bt1120->rk628, HDMI_RX_AUD_MUTE_CTRL,
-			APPLY_INT_MUTE(0)	|
-			APORT_SHDW_CTRL(3)	|
-			AUTO_ACLK_MUTE(2)	|
-			AUD_MUTE_SPEED(1)	|
-			AUD_AVMUTE_EN(1)	|
-			AUD_MUTE_SEL(0)		|
-			AUD_MUTE_MODE(1));
-
-	rk628_i2c_write(bt1120->rk628, HDMI_RX_AUD_PAO_CTRL,
-			PAO_RATE(0));
-	rk628_i2c_write(bt1120->rk628, HDMI_RX_AUD_CHEXTR_CTRL,
-			AUD_LAYOUT_CTRL(1));
-	bt1120->ctsn_ints_en = true;
-	rk628_i2c_write(bt1120->rk628, HDMI_RX_PDEC_IEN_SET, ACR_N_CHG_ICLR | ACR_CTS_CHG_ICLR);
-	/* audio detect */
-	rk628_i2c_write(bt1120->rk628, HDMI_RX_PDEC_AUDIODET_CTRL,
-			AUDIODET_THRESHOLD(0));
-}
