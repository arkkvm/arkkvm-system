From 61065b5733ad06a3599e23dc0724c5087f88ee86 Mon Sep 17 00:00:00 2001
From: Guochun Huang <hero.huang@rock-chips.com>
Date: Thu, 21 Oct 2021 14:41:29 +0800
Subject: [PATCH 115/232] misc: rk628: combtxphy: reducing LVDS power
 consumption

Signed-off-by: Guochun Huang <hero.huang@rock-chips.com>
Change-Id: I5aebe49231270fa9cfb94a4f2c5cd790fd3af371
---
 drivers/misc/rk628/rk628_combtxphy.c | 7 ++++++-
 drivers/misc/rk628/rk628_combtxphy.h | 5 +++++
 2 files changed, 11 insertions(+), 1 deletion(-)

diff --git a/drivers/misc/rk628/rk628_combtxphy.c b/drivers/misc/rk628/rk628_combtxphy.c
index 70ac90f9b9ae58..7def6bf58972a3 100644
--- a/drivers/misc/rk628/rk628_combtxphy.c
+++ b/drivers/misc/rk628/rk628_combtxphy.c
@@ -66,8 +66,13 @@ static void rk628_combtxphy_lvds_power_on(struct rk628 *rk628)
 	u32 val;
 	int ret;
 
+	/* Adjust terminal resistance 133 ohm, bypass 0.95v ldo for driver. */
 	rk628_i2c_update_bits(rk628, COMBTXPHY_CON7,
-			      SW_TX_MODE_MASK, SW_TX_MODE(3));
+			      SW_TX_RTERM_MASK | SW_TX_MODE_MASK |
+			      BYPASS_095V_LDO_MASK | TX_COM_VOLT_ADJ_MASK,
+			      SW_TX_RTERM(6) | SW_TX_MODE(3) |
+			      BYPASS_095V_LDO(1) | TX_COM_VOLT_ADJ(0));
+
 	rk628_i2c_write(rk628, COMBTXPHY_CON10, TX7_CKDRV_EN | TX2_CKDRV_EN);
 	rk628_i2c_update_bits(rk628, COMBTXPHY_CON0,
 			      SW_BUS_WIDTH_MASK | SW_GVI_LVDS_EN_MASK |
diff --git a/drivers/misc/rk628/rk628_combtxphy.h b/drivers/misc/rk628/rk628_combtxphy.h
index 3df3fd778561ec..c7c219de26709c 100644
--- a/drivers/misc/rk628/rk628_combtxphy.h
+++ b/drivers/misc/rk628/rk628_combtxphy.h
@@ -51,6 +51,11 @@
 #define SW_TX_CTL_CON5(x)	UPDATE(x, 10, 10)
 #define SW_TX_CTL_CON4_MASK	GENMASK(9, 8)
 #define SW_TX_CTL_CON4(x)	UPDATE(x, 9, 8)
+#define BYPASS_095V_LDO_MASK    BIT(3)
+#define BYPASS_095V_LDO(x)      UPDATE(x, 3, 3)
+#define TX_COM_VOLT_ADJ_MASK    GENMASK(2, 0)
+#define TX_COM_VOLT_ADJ(x)      UPDATE(x, 2, 0)
+
 #define COMBTXPHY_CON8		REG(0x0020)
 #define COMBTXPHY_CON9		REG(0x0024)
 #define SW_DSI_FSET_EN_MASK	BIT(29)
-- 
2.17.1

