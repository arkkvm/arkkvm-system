+static irqreturn_t rk628_bt1120_irq_handler(int irq, void *dev_id)
+{
+	struct rk628_bt1120 *bt1120 = dev_id;
+	bool handled = false;
+
+	rk628_bt1120_isr(&bt1120->sd, 0, &handled);
+
+	return handled ? IRQ_HANDLED : IRQ_NONE;
+}
