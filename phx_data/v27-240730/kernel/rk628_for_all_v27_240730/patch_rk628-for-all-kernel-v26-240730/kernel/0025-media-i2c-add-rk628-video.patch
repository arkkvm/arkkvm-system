+static inline void testif_testclk_assert(struct rk628_csi *csi)
+{
+	rk628_i2c_update_bits(GRF_MIPI_TX0_CON,
+			   PHY_TESTCLK, PHY_TESTCLK);
+	udelay(1);
+}
+
+static inline void testif_testclk_deassert(struct rk628_csi *csi)
+{
+	rk628_i2c_update_bits(GRF_MIPI_TX0_CON,
+			   PHY_TESTCLK, 0);
+	udelay(1);
+}
