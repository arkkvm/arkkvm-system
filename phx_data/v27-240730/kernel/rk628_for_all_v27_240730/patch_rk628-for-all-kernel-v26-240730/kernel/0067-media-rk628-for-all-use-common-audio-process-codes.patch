-	rk628_i2c_write(bt1120->rk628, HDMI_RX_AUD_FIFO_CTRL, 0x10001);
-	rk628_i2c_write(bt1120->rk628, HDMI_RX_AUD_FIFO_CTRL, 0x10000);
-	rk628_i2c_update_bits(bt1120->rk628, HDMI_RX_AUD_FIFO_TH,
-			   AFIF_TH_START_MASK,
