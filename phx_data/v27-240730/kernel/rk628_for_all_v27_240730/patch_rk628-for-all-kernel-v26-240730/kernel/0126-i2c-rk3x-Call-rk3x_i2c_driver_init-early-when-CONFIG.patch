From 72c595e33e402f0eaeb5d52e658390d45e70354d Mon Sep 17 00:00:00 2001
From: Guochun Huang <hero.huang@rock-chips.com>
Date: Tue, 4 Jan 2022 11:44:10 +0800
Subject: [PATCH 126/232] i2c: rk3x: Call rk3x_i2c_driver_init() early when
 CONFIG_ROCKCHIP_THUNDER_BOOT_RK628=y

Signed-off-by: Guochun Huang <hero.huang@rock-chips.com>
Change-Id: Ia4918d5a1173a7f5ecd47b626476ce904dda620c
---
 drivers/i2c/busses/i2c-rk3x.c | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/drivers/i2c/busses/i2c-rk3x.c b/drivers/i2c/busses/i2c-rk3x.c
index 8a1adb5adf12e9..0864ad095b574c 100644
--- a/drivers/i2c/busses/i2c-rk3x.c
+++ b/drivers/i2c/busses/i2c-rk3x.c
@@ -1469,7 +1469,21 @@ static struct platform_driver rk3x_i2c_driver = {
 	},
 };
 
+#ifdef CONFIG_ROCKCHIP_THUNDER_BOOT_RK628
+static int __init rk3x_i2c_driver_init(void)
+{
+	return platform_driver_register(&rk3x_i2c_driver);
+}
+subsys_initcall(rk3x_i2c_driver_init);
+
+static void __exit rk3x_i2c_driver_exit(void)
+{
+	platform_driver_unregister(&rk3x_i2c_driver);
+}
+module_exit(rk3x_i2c_driver_exit);
+#else
 module_platform_driver(rk3x_i2c_driver);
+#endif
 
 MODULE_DESCRIPTION("Rockchip RK3xxx I2C Bus driver");
 MODULE_AUTHOR("Max Schwarz <max.schwarz@online.de>");
-- 
2.17.1

