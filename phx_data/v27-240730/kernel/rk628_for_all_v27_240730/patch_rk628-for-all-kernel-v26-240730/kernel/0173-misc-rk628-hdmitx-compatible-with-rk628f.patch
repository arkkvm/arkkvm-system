From 2bfb7e2a1eecb3d870aa77e487d2fe38481b7d2e Mon Sep 17 00:00:00 2001
From: Guochun Huang <hero.huang@rock-chips.com>
Date: Tue, 31 Oct 2023 10:11:49 +0000
Subject: [PATCH 173/232] misc: rk628: hdmitx: compatible with rk628f

Change-Id: I9db10ee75e1bf099d39c3926f7cd66c0bb4e3b84
Signed-off-by: Guochun Huang <hero.huang@rock-chips.com>
---
 drivers/misc/rk628/rk628_hdmitx.c | 11 +++++++++--
 1 file changed, 9 insertions(+), 2 deletions(-)

diff --git a/drivers/misc/rk628/rk628_hdmitx.c b/drivers/misc/rk628/rk628_hdmitx.c
index 9c97001c3f5f66..1f3c2c12075803 100644
--- a/drivers/misc/rk628/rk628_hdmitx.c
+++ b/drivers/misc/rk628/rk628_hdmitx.c
@@ -1493,6 +1493,8 @@ int rk628_hdmitx_enable(struct rk628 *rk628)
 {
 	struct device *dev = rk628->dev;
 	struct rk628_hdmi *hdmi;
+	u32 mask = SW_OUTPUT_MODE_MASK;
+	u32 val = SW_OUTPUT_MODE(OUTPUT_MODE_HDMI);
 	int irq;
 	int ret;
 
@@ -1504,9 +1506,14 @@ int rk628_hdmitx_enable(struct rk628 *rk628)
 	rk628_i2c_update_bits(rk628, GRF_POST_PROC_CON,
 			   SW_HDMITX_VCLK_PLLREF_SEL_MASK,
 			   SW_HDMITX_VCLK_PLLREF_SEL(1));
+
+	if (rk628->version == RK628F_VERSION) {
+		mask = SW_HDMITX_EN_MASK;
+		val = SW_HDMITX_EN(1);
+	}
+
 	/* set output mode to HDMI */
-	rk628_i2c_update_bits(rk628, GRF_SYSTEM_CON0, SW_OUTPUT_MODE_MASK,
-			   SW_OUTPUT_MODE(OUTPUT_MODE_HDMI));
+	rk628_i2c_update_bits(rk628, GRF_SYSTEM_CON0, mask, val);
 	/* hdmitx int en */
 	rk628_i2c_write(rk628, GRF_INTR0_EN, 0x00040004);
 
-- 
2.17.1

